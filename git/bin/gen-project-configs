#!/bin/sh
# gen-project-configs — create best-effort project layout metadata under
# $XDG_CONFIG_HOME/tmux-agent-workbench/projects.
#
# Existing configs are user-owned and never overwritten unless --force is
# passed. With explicit paths, generate only those projects; without paths,
# discover projects from WORKBENCH_CODE_ROOT and WORKBENCH_WORKSPACE_ROOT.
#
# usage: gen-project-configs [--force] [project-path ...]
set -eu

self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
dir=$(cd "$(dirname "$self")" && pwd -P)
. "$dir/../../lib/project-config.sh"

force=0
case ${1:-} in
  --force) force=1; shift ;;
esac

guess_dev_command() {
  gp_path=$1
  gp_package=$gp_path/package.json
  gp_prefix=
  if [ ! -f "$gp_package" ] && [ -f "$gp_path/frontend/package.json" ]; then
    gp_package=$gp_path/frontend/package.json
    gp_prefix='cd frontend && '
  fi
  [ -f "$gp_package" ] || return 0

  gp_root=$(dirname "$gp_package")
  if [ -f "$gp_root/pnpm-lock.yaml" ] || [ -f "$gp_path/pnpm-workspace.yaml" ]; then
    gp_pm=pnpm
  elif [ -f "$gp_root/yarn.lock" ]; then
    gp_pm=yarn
  elif [ -f "$gp_root/bun.lock" ] || [ -f "$gp_root/bun.lockb" ]; then
    gp_pm=bun
  else
    gp_pm=npm
  fi

  gp_script=dev
  if command -v jq >/dev/null 2>&1; then
    if ! jq -e '.scripts.dev | type == "string"' "$gp_package" >/dev/null 2>&1; then
      if jq -e '.scripts.start | type == "string"' "$gp_package" >/dev/null 2>&1; then
        gp_script=start
      else
        return 0
      fi
    fi
  fi
  printf '%s%s run %s\n' "$gp_prefix" "$gp_pm" "$gp_script"
}

write_project_config() {
  gp_path=$(cd "$1" 2>/dev/null && pwd -P) || return 0
  gp_file=$(project_config_path "$gp_path")
  if [ -f "$gp_file" ] && [ "$force" = 0 ]; then
    skipped=$((skipped + 1))
    return 0
  fi
  mkdir -p "$(dirname "$gp_file")"
  gp_dev=$(guess_dev_command "$gp_path")
  {
    printf '# Generated by gen-project-configs; safe to edit.\n'
    printf '# Re-run with --force to replace manual changes with fresh guesses.\n'
    printf 'layout=even-vertical\n'
    printf 'dev_command=%s\n' "$gp_dev"
  } > "$gp_file"
  written=$((written + 1))
}

written=0
skipped=0
if [ $# -gt 0 ]; then
  for gp_arg in "$@"; do write_project_config "$gp_arg"; done
else
  code_root=${WORKBENCH_CODE_ROOT:-$HOME/Code}
  workspace_root=${WORKBENCH_WORKSPACE_ROOT:-$HOME/Workspace}
  code_root=$(cd "$code_root" 2>/dev/null && pwd -P || printf '%s\n' "$code_root")
  workspace_root=$(cd "$workspace_root" 2>/dev/null && pwd -P || printf '%s\n' "$workspace_root")
  gp_seen='|'
  for gp_candidate in "$code_root"/*/ "$code_root"/*/*/ "$code_root"/*/*/*/ \
    "$workspace_root"/*/*/; do
    [ -d "$gp_candidate" ] || continue
    gp_top=$(git -C "$gp_candidate" rev-parse --show-toplevel 2>/dev/null) || continue
    [ "$gp_top" = "${gp_candidate%/}" ] || continue
    gp_name=$(project_config_name "$gp_top")
    case $gp_seen in *"|$gp_name|"*) continue ;; esac
    gp_seen="$gp_seen$gp_name|"
    write_project_config "$gp_top"
  done
fi

printf 'gen-project-configs: wrote %s configs (%s existing kept) → %s\n' \
  "$written" "$skipped" "$(project_config_dir)"

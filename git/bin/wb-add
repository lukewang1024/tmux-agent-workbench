#!/bin/sh
# Add an isolated checkout to the calling task, without opening any tools.

# Context variables are assigned by the sourced task-context helpers.
# shellcheck disable=SC2154
set -eu
# Resolve $0 through symlinks so sibling dirs (lib/, bin/) resolve even when the
# script is invoked via a PATH symlink (e.g. ~/.local/bin/<name>).
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
dir=$(cd "$(dirname "$self")" && pwd -P)

usage() {
  cat <<'EOF'
usage: tmux-agent-workbench add [--base <remote-branch>] <repo>[:<branch>]

Add a repository worktree to the current task. Set WORKBENCH_SESSION and
WORKBENCH_TASK to target another task explicitly. The requirement branch
defaults to task/direction/task. A new requirement branch starts from the named
remote base branch, or origin/HEAD when --base is omitted.

options:
  --base <branch>  remote branch under origin used to create a new requirement branch
  -h, --help  show this help and exit
EOF
}

base_branch=
repo_spec=
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --base)
      [ $# -ge 2 ] || { echo "tmux-agent-workbench add: --base requires a branch" >&2; exit 2; }
      base_branch=$2
      shift 2
      ;;
    --)
      shift
      [ $# -eq 1 ] && [ -z "$repo_spec" ] || { echo "tmux-agent-workbench add: expected one repository after --" >&2; exit 2; }
      repo_spec=$1
      shift
      break
      ;;
    -*) echo "tmux-agent-workbench add: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)
      [ -z "$repo_spec" ] || { echo "tmux-agent-workbench add: expected exactly one repository" >&2; usage >&2; exit 2; }
      repo_spec=$1
      shift
      ;;
  esac
done
[ $# -eq 0 ] || { echo "tmux-agent-workbench add: unexpected arguments after --" >&2; usage >&2; exit 2; }
[ -n "$repo_spec" ] || { usage >&2; exit 2; }

WORKBENCH_CODE_ROOT="${WORKBENCH_CODE_ROOT:-$HOME/Code}"
WORKBENCH_CODE_ROOT=$(cd "$WORKBENCH_CODE_ROOT" 2>/dev/null && pwd -P) || { echo "tmux-agent-workbench add: WORKBENCH_CODE_ROOT not found: $WORKBENCH_CODE_ROOT" >&2; exit 1; }
WORKBENCH_WORKSPACE_ROOT="${WORKBENCH_WORKSPACE_ROOT:-$HOME/Workspace}"

. "$dir/../../lib/resolve-session.sh"
. "$dir/../../lib/task-context.sh"
workbench_task_context
feature=$wb_direction
wsdir=$wb_workspace
default_branch=$(printf 'task/%s/%s' "$feature" "$wb_task" | tr ' .:' '___')
[ "$wb_task_root" != "$wb_workspace" ] || default_branch=$feature
lock=workbench-repos-$wb_session
tmux wait-for -L "$lock"
trap 'tmux wait-for -U "$lock" 2>/dev/null || true' 0
trap 'exit 1' HUP INT TERM

case $repo_spec in
  *:*) rname=${repo_spec%%:*}; rbranch=${repo_spec#*:} ;;
  *)   rname=$repo_spec;       rbranch=$default_branch ;;
esac
case $rname in ''|.|..|*/*) echo "workbench: invalid repository name: $rname" >&2; exit 2 ;; esac
[ -n "$rname" ] && [ -n "$rbranch" ] || { echo "tmux-agent-workbench add: repository and requirement branch must be non-empty" >&2; exit 2; }
git check-ref-format --branch "$rbranch" >/dev/null 2>&1 || { echo "tmux-agent-workbench add: invalid requirement branch: $rbranch" >&2; exit 2; }
if [ -n "$base_branch" ]; then
  case $base_branch in origin/*) base_branch=${base_branch#origin/} ;; esac
  git check-ref-format --branch "$base_branch" >/dev/null 2>&1 || { echo "tmux-agent-workbench add: invalid remote base branch: $base_branch" >&2; exit 2; }
fi

# Same exact-basename resolution tmux-agent-workbench new uses: never matches a numbered pool
# slot like web-app-3, since those are never named exactly `web-app`.
main=
for c in "$WORKBENCH_CODE_ROOT/$rname" "$WORKBENCH_CODE_ROOT"/*/"$rname" "$WORKBENCH_CODE_ROOT"/*/*/"$rname"; do
  [ -d "$c" ] || continue
  top=$(git -C "$c" rev-parse --show-toplevel 2>/dev/null) || continue
  [ "$top" = "$c" ] || continue
  main=$top; break
done
[ -n "$main" ] || { echo "tmux-agent-workbench add: no repo named '$rname' found under $WORKBENCH_CODE_ROOT" >&2; exit 1; }

dest="$wb_task_root/$(basename "$main")"

git -C "$main" remote get-url origin >/dev/null 2>&1 || {
  echo "tmux-agent-workbench add: $rname has no origin remote" >&2
  exit 1
}
echo "tmux-agent-workbench add: fetching origin for $rname"
workbench_export_proxies
git -C "$main" fetch origin

if [ ! -e "$dest" ]; then
  if git -C "$main" show-ref --verify --quiet "refs/heads/$rbranch"; then
    git -C "$main" worktree add "$dest" "$rbranch"
  else
    if [ -n "$base_branch" ]; then
      base="refs/remotes/origin/$base_branch"
    else
      base=$(git -C "$main" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null) || base=""
    fi
    [ -n "$base" ] || {
      echo "tmux-agent-workbench add: cannot resolve origin/HEAD for $rname; specify or repair the remote default branch" >&2
      exit 1
    }
    git -C "$main" show-ref --verify --quiet "$base" || {
      echo "tmux-agent-workbench add: remote base branch does not exist after fetch: ${base#refs/remotes/}" >&2
      exit 1
    }
    git -C "$main" worktree add --no-track -b "$rbranch" "$dest" "$base"
  fi
  echo "tmux-agent-workbench add: $rname -> $dest (branch $rbranch)"
else
  [ ! -L "$dest" ] || { echo "tmux-agent-workbench add: refusing symlink worktree: $dest" >&2; exit 1; }
  actual_top=$(git -C "$dest" rev-parse --show-toplevel 2>/dev/null) || {
    echo "tmux-agent-workbench add: existing path is not a Git worktree: $dest" >&2
    exit 1
  }
  actual_top=$(cd "$actual_top" && pwd -P)
  [ "$actual_top" = "$(cd "$dest" && pwd -P)" ] || {
    echo "tmux-agent-workbench add: existing path is not the worktree root: $dest" >&2
    exit 1
  }
  main_common=$(git -C "$main" rev-parse --path-format=absolute --git-common-dir)
  dest_common=$(git -C "$dest" rev-parse --path-format=absolute --git-common-dir)
  main_common=$(cd "$main_common" && pwd -P)
  dest_common=$(cd "$dest_common" && pwd -P)
  [ "$main_common" = "$dest_common" ] || {
    echo "tmux-agent-workbench add: existing worktree belongs to a different repository: $dest" >&2
    exit 1
  }
  actual_branch=$(git -C "$dest" symbolic-ref --short -q HEAD 2>/dev/null) || actual_branch=""
  [ -n "$actual_branch" ] || { echo "tmux-agent-workbench add: existing worktree is detached: $dest" >&2; exit 1; }
  [ "$actual_branch" = "$rbranch" ] || {
    echo "tmux-agent-workbench add: existing worktree branch is $actual_branch, requested $rbranch: $dest" >&2
    exit 1
  }
fi

# Repositories may opt into lightweight, local worktree initialization through
# a script owned by the trusted main checkout. Run it for both new and existing
# worktrees so it can be idempotent and repair missing generated state. Refuse
# symlinks: tmux-agent-workbench add must not follow a branch- or filesystem-controlled redirect
# before executing repository code.
initializer="$main/.workbench/worktree-init"
if [ -L "$initializer" ]; then
  echo "tmux-agent-workbench add: refusing symlink initializer: $initializer" >&2
  exit 1
fi
if [ -e "$initializer" ]; then
  [ -f "$initializer" ] || { echo "tmux-agent-workbench add: initializer is not a regular file: $initializer" >&2; exit 1; }
  [ -x "$initializer" ] || { echo "tmux-agent-workbench add: initializer is not executable: $initializer" >&2; exit 1; }
  actual_branch=$(git -C "$dest" symbolic-ref --short -q HEAD 2>/dev/null) || actual_branch=$rbranch
  echo "tmux-agent-workbench add: running $initializer"
  (
    cd "$dest"
    WORKBENCH_INIT_PROTOCOL=1 \
    WORKBENCH_MAIN_CHECKOUT="$main" \
    WORKBENCH_WORKTREE="$dest" \
    WORKBENCH_WORKSPACE="$wsdir" \
    WORKBENCH_FEATURE="$feature" \
    WORKBENCH_TASK="$wb_task" \
    WORKBENCH_TASK_ROOT="$wb_task_root" \
    WORKBENCH_REPO="$rname" \
    WORKBENCH_BRANCH="$actual_branch" \
    PWD="$dest" \
      "$initializer"
  ) || {
    rc=$?
    echo "tmux-agent-workbench add: repository initializer failed (exit $rc); worktree kept at $dest" >&2
    exit "$rc"
  }
fi

if command -v zoxide > /dev/null 2>&1; then zoxide add "$dest" || true; fi

"$dir/../../bin/tmux-agent-workbench-cli" projects rebuild "$WORKBENCH_CODE_ROOT" "$WORKBENCH_WORKSPACE_ROOT"
printf '%s\n' "$dest"

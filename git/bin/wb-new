#!/bin/sh
# A session groups a direction; its windows are independent tasks.
set -eu
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
dir=$(CDPATH='' cd -- "$(dirname "$self")" && pwd -P)
cli=$dir/../../bin/tmux-agent-workbench-cli
. "$dir/../../lib/resolve-session.sh"
. "$dir/../../lib/task-context.sh"

usage() {
  cat <<'EOF'
usage: tmux-agent-workbench new [--detach] [--task <name>] <direction> [repo[:branch] ...]

Create or reopen a workspace session and its first task. The first task defaults
to the direction name. Add parallel work with task new <name> [repo[:branch] ...].

options:
  --detach       create without attaching or switching clients
  --task <name>  name of the initial task
  -h, --help     show this help and exit
EOF
}

task=
detach=0
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --detach) detach=1; shift ;;
    --task) [ $# -ge 2 ] || { usage >&2; exit 2; }; task=$2; shift 2 ;;
    --) shift; break ;;
    -*) echo "tmux-agent-workbench new: unknown option: $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { usage >&2; exit 2; }
direction=$1; shift
task=${task:-$direction}
workbench_valid_name "$direction" || exit 2
workbench_valid_name "$task" || exit 2
workspace=${WORKBENCH_WORKSPACE_ROOT:-$HOME/Workspace}/$direction
[ ! -L "$workspace" ] && [ ! -L "$workspace/tasks" ] || {
  echo 'workbench: refusing a symlink workspace directory.' >&2; exit 1
}
mkdir -p "$workspace"
workspace=$(CDPATH='' cd "$workspace" && pwd -P)
if ! tmux has-session -t "=$direction" 2>/dev/null; then
  task_root=$workspace/tasks/$task
  mkdir -p "$task_root"
  pane=$(tmux new-session -d -s "$direction" -c "$workspace" -n "$task" -P -F '#{pane_id}')
  tmux set-option -t "$direction" @workbench_workspace_root "$workspace"
  tmux set-option -t "$direction" @workbench_task 1
  tmux set-option -w -t "$pane" @workbench_task_root "$task_root"
  tmux set-option -w -t "$pane" @workbench_task_name "$task"
else
  actual=$(tmux show-option -qv -t "$direction" @workbench_workspace_root)
  if [ -z "$actual" ]; then
    actual=$(tmux display-message -p -t "=$direction" '#{session_path}')
    actual=$(CDPATH='' cd "$actual" && pwd -P)
    [ "$actual" != "$workspace" ] || tmux set-option -t "=$direction" @workbench_workspace_root "$workspace"
  fi
  [ "$actual" = "$workspace" ] || {
    echo "workbench: session $direction already exists; its workspace does not match $workspace." >&2
    exit 1
  }
fi
WORKBENCH_SESSION=$direction "$cli" task new --detach "$task" "$@"
if command -v zoxide >/dev/null 2>&1; then zoxide add "$workspace" || true; fi
"$cli" projects rebuild
[ "$detach" = 0 ] || exit 0
if [ -n "${WORKBENCH_TARGET_CLIENT:-}" ]; then exec tmux switch-client -c "$WORKBENCH_TARGET_CLIENT" -t "$direction"
elif [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "$direction"
else exec tmux attach -t "$direction"
fi

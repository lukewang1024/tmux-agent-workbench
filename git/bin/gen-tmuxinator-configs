#!/bin/sh
# Generate project launchers: one workspace session, one window per task.
# Code-pool entries create an isolated first task rather than edit the shared
# checkout. Legacy workspace directories reopen as a single existing task.
# No Git, editor, shell, or dev-server inspection layouts are pre-created.
set -eu
# Resolve $0 through symlinks so sibling dirs (lib/, bin/) resolve even when the
# script is invoked via a PATH symlink (e.g. ~/.local/bin/<name>).
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done

WORKBENCH_CODE_ROOT="${1:-${WORKBENCH_CODE_ROOT:-$HOME/Code}}"
WORKBENCH_CODE_ROOT=$(cd "$WORKBENCH_CODE_ROOT" 2>/dev/null && pwd -P || echo "$WORKBENCH_CODE_ROOT")  # canonical
WORKBENCH_WORKSPACE_ROOT="${2:-${WORKBENCH_WORKSPACE_ROOT:-$HOME/Workspace}}"
DEST="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator"
MARKER="# @generated by gen-tmuxinator-configs — do not edit; re-run to refresh"
mkdir -p "$DEST"

# Wipe our previously-generated files (keep hand-made ones); we rewrite the
# current set below, so vanished and now-excluded worktrees/workspaces drop
# out cleanly.
for f in "$DEST"/*.yml; do
  [ -e "$f" ] || continue
  IFS= read -r first < "$f" || continue
  case "$first" in "$MARKER"*) rm -f "$f" ;; esac
done
IGNORE="$DEST/.genignore"
written=0 skipped=0

quote_arg() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

quote_yaml() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

write_window() {
  window_name=$1
  window_root=$2
  restore_workspace=$3
  restore_legacy=$4
  seed_repo=${5:-}
  restore_command="tmux-agent-workbench task restore "
  [ "$restore_legacy" = 0 ] || restore_command="$restore_command--legacy "
  restore_command="$restore_command--workspace $(quote_arg "$restore_workspace") $(quote_arg "$window_name")"
  [ -z "$seed_repo" ] || restore_command="$restore_command $(quote_arg "$seed_repo")"
  printf '  - %s:\n' "$(quote_yaml "$window_name")"
  printf '      root: %s\n' "$(quote_yaml "$window_root")"
  printf '      panes:\n'
  printf '        - %s\n' "$(quote_yaml "$restore_command")"
}

# ---------------------------------------------------------------------------
# Part A — WORKBENCH_CODE_ROOT: one config per main checkout / numbered pool
# slot.
# ---------------------------------------------------------------------------

# 1. Discover every worktree root. Scan a few depths to find at least one
#    checkout per repo, then let `git worktree list` expand to the full set
#    (catches deeply-nested worktrees the dir scan alone would miss).
seeds=$(cd "$WORKBENCH_CODE_ROOT" && for d in */ */*/ */*/*/; do
  [ -d "$d" ] || continue
  git -C "$d" rev-parse --show-toplevel 2>/dev/null || true
done | sort -u)

roots=$(for s in $seeds; do
  git -C "$s" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p'
done | sort -u)

# Primary (main) worktree of each repo = the first entry git lists for it.
primaries=$(for s in $seeds; do
  git -C "$s" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -1
done | sort -u)

# 2. Keep only the persistent pool: must live under WORKBENCH_CODE_ROOT
#    (drops stray worktrees registered in /tmp etc.), not under any
#    `<repo>-worktrees/` dir (the ag-dev use-and-throw convention), and not
#    nested inside another root (submodules, e.g. .../shared-schemas). A non-primary
#    worktree is kept only if it is a numbered slot `<repo>-<number>`.
# Accumulate into a variable rather than wrapping this loop in $(...): macOS's
# bash 3.2 mis-parses a `case` pattern's `)` inside $(...) as closing the
# substitution, so the case statements below must not live in a sub-shell.
filtered=
for r in $roots; do
  case "$r" in "$WORKBENCH_CODE_ROOT"/*) : ;; *) continue ;; esac
  case "$r" in */z-archive/*) continue ;; esac
  case "$r" in *-worktrees/*) continue ;; esac
  nested=0
  for p in $roots; do
    [ "$r" = "$p" ] && continue
    case "$r" in "$p"/*) nested=1; break ;; esac
  done
  [ "$nested" = 1 ] && continue
  is_primary=0
  for pm in $primaries; do [ "$r" = "$pm" ] && { is_primary=1; break; }; done
  if [ "$is_primary" = 0 ]; then
    base=$(basename "$r"); num=${base##*-}        # part after the last '-'
    case "$base" in "$num") continue ;; esac      # no '-' at all → not a slot
    case "$num" in ''|*[!0-9]*) continue ;; esac  # suffix not all digits → skip
  fi
  filtered="$filtered$r
"
done
roots=$filtered

# 3. Write one named config per root (honoring .genignore manual exclusions).
for r in $roots; do
  name=$(basename "$r" | tr ' .:/' '____')   # tmux-safe session name
  if [ -f "$IGNORE" ] && grep -qxF "$name" "$IGNORE" 2>/dev/null; then
    skipped=$((skipped + 1)); continue
  fi
  {
    printf '%s (%s)\n' "$MARKER" "$r"
    printf 'name: %s\n' "$(quote_yaml "$name")"
    printf 'root: %s\n' "$(quote_yaml "$r")"
    printf 'windows:\n'
    write_window "$name" "$r" "$WORKBENCH_WORKSPACE_ROOT/$name" 0 "$(basename "$r")"
  } > "$DEST/$name.yml"
  written=$((written + 1))
done

# ---------------------------------------------------------------------------
# Part B — WORKBENCH_WORKSPACE_ROOT: one config per level-1 workspace dir,
# reopening one agent window per task, without restoring temporary tools.
# ---------------------------------------------------------------------------
WS_ROOT=$(cd "$WORKBENCH_WORKSPACE_ROOT" 2>/dev/null && pwd -P || echo "")
ws_written=0

if [ -n "$WS_ROOT" ]; then
  for w in "$WS_ROOT"/*/; do
    [ -d "$w" ] || continue
    w=${w%/}
    wsname=$(basename "$w" | tr ' .:/' '____')

    if [ -f "$IGNORE" ] && grep -qxF "$wsname" "$IGNORE" 2>/dev/null; then
      skipped=$((skipped + 1)); continue
    fi
    {
      printf '%s (workspace: %s)\n' "$MARKER" "$w"
      printf 'name: %s\n' "$(quote_yaml "$wsname")"
      printf 'root: %s\n' "$(quote_yaml "$w")"
      printf 'windows:\n'
      task_count=0
      for task_root in "$w"/tasks/*; do
        [ -d "$task_root" ] && [ ! -L "$task_root" ] || continue
        write_window "$(basename "$task_root")" "$task_root" "$w" 0
        task_count=$((task_count + 1))
      done
      if [ "$task_count" -eq 0 ]; then
        write_window "$wsname" "$w" "$w" 1
      else
        # A legacy task may coexist with newly created isolated tasks.
        for member in "$w"/.git "$w"/*/.git; do
          [ -e "$member" ] || continue
          write_window "$wsname" "$w" "$w" 1
          break
        done
      fi
    } > "$DEST/$wsname.yml"
    ws_written=$((ws_written + 1))
  done
fi
written=$((written + ws_written))

summary=$(printf 'gen-tmuxinator-configs: wrote %s pool configs (%s code, %s workspace; %s ignored)' \
  "$written" "$((written - ws_written))" "$ws_written" "$skipped")
printf '%s → %s\n' "$summary" "$DEST"
[ -z "${TMUX:-}" ] || tmux display-message "$summary" 2>/dev/null || true
exit 0

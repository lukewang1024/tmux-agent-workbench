#!/bin/sh
# gen-tmuxinator-configs — (re)generate machine-local tmuxinator named configs
# in ~/.config/tmuxinator/ from two pools:
#
#   WORKBENCH_CODE_ROOT (~/Code)      — each repo's main checkout, plus
#                              numbered pool slots whose dir is named
#                              `<repo>-<number>` (e.g. axon-web-7). One config
#                              per root, seeded with that single repo — a
#                              single-repo task.
#   WORKBENCH_WORKSPACE_ROOT (~/Workspace) — each workspace dir is one
#                              feature; its immediate children are per-repo
#                              worktrees for that feature. One config per
#                              workspace, seeded from its first member repo,
#                              with every member repo pre-built as its own
#                              inspection window (a workspace's repos are all
#                              known up front, so there's no need to wait on
#                              lazy `mux-inspect` accretion for the ones you
#                              already know about — though it still works for
#                              a repo the task touches later that wasn't part
#                              of the set).
#
# Skipped everywhere: anything under a `z-archive/` dir (parked repos — pull
# one out manually when you need it), use-and-throw worktrees under any
# `<repo>-worktrees/` dir (the ag-dev per-task convention — a separate,
# ephemeral pool, not a feature workspace), worktrees registered outside
# WORKBENCH_CODE_ROOT/WORKBENCH_WORKSPACE_ROOT, and non-numbered extra
# worktrees under WORKBENCH_CODE_ROOT.
#
# Manual exclusions persist across re-runs via a one-name-per-line ignore file
# at ~/.config/tmuxinator/.genignore (blank lines and #comments allowed;
# matched against the generated session name, so it covers both pools).
#
# Layout (task/window model — a session is a task, seeded with one repo):
#   - agent window: the session-level coding agent (mux-agent → claude/codex/
#     opencode via $WORKBENCH_AGENT), rooted at the repo. This is where you
#     steer.
#   - <repo> window: that repo's inspection surface, three panes stacked
#     even-vertical — a git TUI on top (tig, or $WORKBENCH_GIT_TOOL e.g.
#     lazygit), an empty scratchpad shell in the middle, an editor on the
#     bottom ($VISUAL/$EDITOR else nvim falling back to vim) (+ a dev-server
#     pane for frontends). Full-screen, small-screen safe. Matches what
#     `mux-inspect` builds at runtime, so a pre-seeded window and a later
#     accreted one look the same.
# The task grows by accretion: fold more repos in as inspection windows with
# prefix+G (manual) or `mux-inspect <path>` (the agent, per the AGENTS.md
# convention). The seed repo above is just window count 1 of that same model.
#
# Re-running: this is the single source of truth driving tmuxinator configs
# from actual git worktree state, so re-run it whenever that state changes —
# by hand (prefix+g, or after cloning a new repo under WORKBENCH_CODE_ROOT —
# there's no hook for that side), or automatically (workspace create/destroy
# tooling should call this at the end of both operations so a torn-down
# workspace's config disappears with it; note a live tmux session isn't
# killed by that — pair teardown with `tmux kill-session -t <workspace>` too
# if it's running).
#
# usage: gen-tmuxinator-configs [code_root] [workspace_root]
#        (default: $WORKBENCH_CODE_ROOT or ~/Code,
#                  $WORKBENCH_WORKSPACE_ROOT or ~/Workspace)

set -eu
# Resolve $0 through symlinks so sibling dirs (lib/, bin/) resolve even when the
# script is invoked via a PATH symlink (e.g. ~/.local/bin/<name>).
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
dir=$(cd "$(dirname "$self")" && pwd -P)
. "$dir/../../lib/resolve-tools.sh"

WORKBENCH_CODE_ROOT="${1:-${WORKBENCH_CODE_ROOT:-$HOME/Code}}"
WORKBENCH_CODE_ROOT=$(cd "$WORKBENCH_CODE_ROOT" 2>/dev/null && pwd -P || echo "$WORKBENCH_CODE_ROOT")  # canonical
WORKBENCH_WORKSPACE_ROOT="${2:-${WORKBENCH_WORKSPACE_ROOT:-$HOME/Workspace}}"
DEST="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator"
MARKER="# @generated by gen-tmuxinator-configs — do not edit; re-run to refresh"
mkdir -p "$DEST"

# Wipe our previously-generated files (keep hand-made ones); we rewrite the
# current set below, so vanished and now-excluded worktrees/workspaces drop
# out cleanly.
for f in "$DEST"/*.yml; do
  [ -e "$f" ] || continue
  IFS= read -r first < "$f" || continue
  case "$first" in "$MARKER"*) rm -f "$f" ;; esac
done
IGNORE="$DEST/.genignore"
written=0 skipped=0

# Same resolution mux-inspect uses at runtime, done once here so every
# generated window matches whatever a later accreted window would look like.
GIT_TOOL=$(resolve_git_tool)
EDITOR_CMD=$(resolve_editor)

# ---------------------------------------------------------------------------
# Part A — WORKBENCH_CODE_ROOT: one config per main checkout / numbered pool
# slot.
# ---------------------------------------------------------------------------

# 1. Discover every worktree root. Scan a few depths to find at least one
#    checkout per repo, then let `git worktree list` expand to the full set
#    (catches deeply-nested worktrees the dir scan alone would miss).
seeds=$(cd "$WORKBENCH_CODE_ROOT" && for d in */ */*/ */*/*/; do
  [ -d "$d" ] || continue
  git -C "$d" rev-parse --show-toplevel 2>/dev/null || true
done | sort -u)

roots=$(for s in $seeds; do
  git -C "$s" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p'
done | sort -u)

# Primary (main) worktree of each repo = the first entry git lists for it.
primaries=$(for s in $seeds; do
  git -C "$s" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -1
done | sort -u)

# 2. Keep only the persistent pool: must live under WORKBENCH_CODE_ROOT
#    (drops stray worktrees registered in /tmp etc.), not under any
#    `<repo>-worktrees/` dir (the ag-dev use-and-throw convention), and not
#    nested inside another root (submodules, e.g. .../shared-schemas). A non-primary
#    worktree is kept only if it is a numbered slot `<repo>-<number>`.
# Accumulate into a variable rather than wrapping this loop in $(...): macOS's
# bash 3.2 mis-parses a `case` pattern's `)` inside $(...) as closing the
# substitution, so the case statements below must not live in a sub-shell.
filtered=
for r in $roots; do
  case "$r" in "$WORKBENCH_CODE_ROOT"/*) : ;; *) continue ;; esac
  case "$r" in */z-archive/*) continue ;; esac
  case "$r" in *-worktrees/*) continue ;; esac
  nested=0
  for p in $roots; do
    [ "$r" = "$p" ] && continue
    case "$r" in "$p"/*) nested=1; break ;; esac
  done
  [ "$nested" = 1 ] && continue
  is_primary=0
  for pm in $primaries; do [ "$r" = "$pm" ] && { is_primary=1; break; }; done
  if [ "$is_primary" = 0 ]; then
    base=$(basename "$r"); num=${base##*-}        # part after the last '-'
    case "$base" in "$num") continue ;; esac      # no '-' at all → not a slot
    case "$num" in ''|*[!0-9]*) continue ;; esac  # suffix not all digits → skip
  fi
  filtered="$filtered$r
"
done
roots=$filtered

# 3. Write one named config per root (honoring .genignore manual exclusions).
for r in $roots; do
  name=$(basename "$r" | tr ' .:/' '____')   # tmux-safe session name
  if [ -f "$IGNORE" ] && grep -qxF "$name" "$IGNORE" 2>/dev/null; then
    skipped=$((skipped + 1)); continue
  fi
  if [ -f "$r/package.json" ] || [ -f "$r/pnpm-workspace.yaml" ] || [ -f "$r/frontend/package.json" ]; then
    fe=1
  else
    fe=0
  fi
  {
    printf '%s (%s)\n' "$MARKER" "$r"
    printf 'name: %s\n' "$name"
    printf 'root: %s\n' "$r"
    printf 'startup_window: agent\n'
    printf 'windows:\n'
    printf '  - agent:\n            - mux-agent\n'
    printf '  - %s:\n' "$name"
    printf '      layout: even-vertical\n'
    printf '      panes:\n'
    printf '        - git:\n            - %s\n' "$GIT_TOOL"
    printf '        - shell:\n'
    printf '        - editor:\n            - %s\n' "$EDITOR_CMD"
    [ "$fe" = 1 ] && printf '        - dev:\n            -\n'
  } > "$DEST/$name.yml"
  written=$((written + 1))
done

# ---------------------------------------------------------------------------
# Part B — WORKBENCH_WORKSPACE_ROOT: one config per workspace dir, seeded from
# its first member repo, with every member repo pre-built as its own
# inspection window.
# ---------------------------------------------------------------------------
WS_ROOT=$(cd "$WORKBENCH_WORKSPACE_ROOT" 2>/dev/null && pwd -P || echo "")
ws_written=0

if [ -n "$WS_ROOT" ]; then
  for w in "$WS_ROOT"/*/; do
    [ -d "$w" ] || continue
    w=${w%/}
    wsname=$(basename "$w" | tr ' .:/' '____')

    # Member repos = immediate subdirs that are themselves a worktree root
    # (not some deeper path inside one — a workspace's repos are direct
    # children by convention).
    members=
    for d in "$w"/*/; do
      [ -d "$d" ] || continue
      d=${d%/}
      top=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) || continue
      [ "$top" = "$d" ] || continue
      members="$members$d
"
    done
    [ -n "$members" ] || continue   # not populated yet — nothing to seed with

    if [ -f "$IGNORE" ] && grep -qxF "$wsname" "$IGNORE" 2>/dev/null; then
      skipped=$((skipped + 1)); continue
    fi

    primary=$(printf '%s' "$members" | head -1)
    {
      printf '%s (workspace: %s)\n' "$MARKER" "$w"
      printf 'name: %s\n' "$wsname"
      printf 'root: %s\n' "$primary"
      printf 'startup_window: agent\n'
      printf 'windows:\n'
      printf '  - agent:\n            - mux-agent\n'
      for m in $members; do
        mname=$(basename "$m" | tr ' .:/' '____')
        if [ -f "$m/package.json" ] || [ -f "$m/pnpm-workspace.yaml" ] || [ -f "$m/frontend/package.json" ]; then
          mfe=1
        else
          mfe=0
        fi
        printf '  - %s:\n' "$mname"
        printf '      root: %s\n' "$m"
        printf '      layout: even-vertical\n'
        printf '      panes:\n'
        printf '        - git:\n            - %s\n' "$GIT_TOOL"
        printf '        - shell:\n'
        printf '        - editor:\n            - %s\n' "$EDITOR_CMD"
        [ "$mfe" = 1 ] && printf '        - dev:\n            -\n'
      done
    } > "$DEST/$wsname.yml"
    ws_written=$((ws_written + 1))
  done
fi
written=$((written + ws_written))

summary=$(printf 'gen-tmuxinator-configs: wrote %s pool configs (%s code, %s workspace; %s ignored)' \
  "$written" "$((written - ws_written))" "$ws_written" "$skipped")
printf '%s → %s\n' "$summary" "$DEST"
[ -n "${TMUX:-}" ] && tmux display-message "$summary"
exit 0

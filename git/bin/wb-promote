#!/bin/sh
# A live process cannot safely be moved to a newly created checkout.
set -eu
case ${1:-} in
  -h|--help)
    printf '%s\n' 'usage: tmux-agent-workbench promote [name]' \
      'This legacy command is retired. Use task new <name> [repo[:branch] ...]' \
      'inside a workspace, or new <direction> to create a workspace.'
    exit 0 ;;
  -*) echo "tmux-agent-workbench promote: unknown option: $1" >&2; exit 2 ;;
esac
printf '%s\n' 'workbench: promote is retired; use task new <name> [repo[:branch] ...].' \
  'A running agent keeps its original checkout; moving its pane would not isolate the task.' >&2
exit 2

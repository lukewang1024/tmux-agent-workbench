#!/bin/sh
# Close a direction and its tasks, retaining any unfinished work.
set -eu
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
dir=$(CDPATH='' cd -- "$(dirname "$self")" && pwd -P)
. "$dir/../../lib/task-context.sh"
. "$dir/../../lib/cleanup-task.sh"
usage() {
  cat <<'EOF'
usage: tmux-agent-workbench done [--force] <direction>

Remove a direction's task worktrees and close its session. Dirty tasks and
scratch files are retained. Use task done <name> to finish just one task.
--force discards uncommitted changes in worktrees, never unrelated files.
EOF
}
force=0
case ${1:-} in
  -h|--help) usage; exit 0 ;;
  --force) force=1; shift ;;
  -*) echo "tmux-agent-workbench done: unknown option: $1" >&2; exit 2 ;;
esac
[ $# -eq 1 ] || { usage >&2; exit 2; }
workbench_valid_name "$1" || exit 2
direction=$1
workspace=${WORKBENCH_WORKSPACE_ROOT:-$HOME/Workspace}/$direction
[ -d "$workspace" ] || exit 0
[ ! -L "$workspace" ] && [ ! -L "$workspace/tasks" ] || exit 1
retained=0
for task_root in "$workspace"/tasks/*; do
  [ -d "$task_root" ] && [ ! -L "$task_root" ] || continue
  if workbench_clean_task "$task_root" "$force"; then
    for window in $(tmux list-windows -a -F '#{window_id}' 2>/dev/null | sort -u); do
      [ "$(tmux show-option -wqv -t "$window" @workbench_task_root)" != "$task_root" ] || tmux kill-window -t "$window"
    done
  else retained=1
  fi
done
if [ -d "$workspace/tasks" ]; then rmdir "$workspace/tasks" 2>/dev/null || retained=1; fi
if [ "$retained" = 0 ]; then
  if workbench_clean_task "$workspace" "$force"; then
    for window in $(tmux list-windows -a -F '#{window_id}' 2>/dev/null | sort -u); do
      [ "$(tmux show-option -wqv -t "$window" @workbench_task_root)" != "$workspace" ] || tmux kill-window -t "$window"
    done
  else retained=1
  fi
fi
"$dir/../../bin/tmux-agent-workbench-cli" projects rebuild
[ "$retained" = 0 ]

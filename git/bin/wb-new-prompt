#!/bin/sh
# Read a workspace name as data in a temporary popup.
set -eu
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
dir=$(CDPATH='' cd -- "$(dirname "$self")" && pwd -P)
cli=$dir/../../bin/tmux-agent-workbench-cli
case ${1:-} in
  -h|--help)
    printf '%s\n' 'usage: tmux-agent-workbench new --prompt' 'Open a popup to name a new workspace direction.'
    exit 0 ;;
  --read)
    printf 'Workspace direction: '
    IFS= read -r direction || exit 0
    [ -n "$direction" ] || exit 0
    exec "$cli" new "$direction"
    ;;
  -*) echo "tmux-agent-workbench new --prompt: unknown option: $1" >&2; exit 2 ;;
esac
[ $# -eq 0 ] || exit 2
. "$dir/../../lib/resolve-session.sh"
caller=$(workbench_resolve_pane)
quoted_script=$(printf '%s' "$dir/wb-new-prompt" | sed "s/'/'\\\\''/g")
set -- display-popup -t "$caller" -E -w 70% -h 7 -e "PATH=$PATH"
[ -z "${WORKBENCH_TARGET_CLIENT:-}" ] || set -- "$@" -c "$WORKBENCH_TARGET_CLIENT" -e "WORKBENCH_TARGET_CLIENT=$WORKBENCH_TARGET_CLIENT"
exec tmux "$@" "'$quoted_script' --read"

#!/bin/sh
# install — symlink this plugin's commands into a bin dir on your PATH.
#
# Self-contained on purpose: this is the plugin's own install story so it
# travels with the plugin when it splits out to its own repo. It knows which
# commands it ships (everything executable under bin/ and git/bin/) so callers
# never have to enumerate them — a dotfiles bootstrap, a fresh clone, or a
# manual run all get the same set, and a command added here needs no edit
# anywhere else.
#
# This covers only the COLD-START case the README describes: invoking these by
# bare name from a shell tmux never touched (or outside tmux entirely, e.g. for
# shell completion / `command -v ws-new`). Anything tmux itself spawns already
# has bin/ and git/bin/ on PATH via workbench.tmux — it does not need this.
#
# Usage:
#   ./install [BIN_DIR] [--no-git]
#
#   BIN_DIR    where to place the symlinks (default: ~/.local/bin)
#   --no-git   skip layer 2 (git/bin/*), matching @workbench-disable-git
#
# Existing regular files/dirs at a target are backed up to `<name>~` (never
# clobbered); an existing symlink already pointing at the right command is left
# alone (idempotent); any other symlink is repointed.
set -eu

PLUGIN_DIR="$(cd "$(dirname "$0")" && pwd)"

BIN_DIR=""
INCLUDE_GIT=1
for arg in "$@"; do
  case "$arg" in
    --no-git) INCLUDE_GIT=0 ;;
    -h|--help)
      sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    -*)
      echo "install: unknown option: $arg" >&2
      exit 1 ;;
    *)
      if [ -n "$BIN_DIR" ]; then
        echo "install: unexpected extra argument: $arg" >&2
        exit 1
      fi
      BIN_DIR="$arg" ;;
  esac
done
BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"
SKILL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/agent/skills"

mkdir -p "$BIN_DIR"

# Attention v2 binary. Release assets use
# tmux-agent-workbench-<rust-target>.tar.gz; a source checkout falls back to a
# local Cargo release build when the matching asset is unavailable.
install_attention_binary() {
  attention_version=$(sed -n 's/^version *= *"\([^"]*\)"/\1/p' "$PLUGIN_DIR/Cargo.toml" | head -1)
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) attention_target=aarch64-apple-darwin ;;
    Darwin-x86_64) attention_target=x86_64-apple-darwin ;;
    Linux-aarch64|Linux-arm64) attention_target=aarch64-unknown-linux-gnu ;;
    Linux-x86_64) attention_target=x86_64-unknown-linux-gnu ;;
    *) attention_target= ;;
  esac
  attention_destination="$BIN_DIR/tmux-agent-workbench"
  attention_stage="$attention_destination.new.$$"

  install_attention_file() {
    attention_source=$1
    rm -f "$attention_stage"
    cp "$attention_source" "$attention_stage"
    case "$(uname -s 2>/dev/null)" in
      Darwin)
        codesign --force --sign - "$attention_stage" >/dev/null
        ;;
    esac
    chmod 755 "$attention_stage"
    mv -f "$attention_stage" "$attention_destination"
  }
  if [ "${TMUX_AGENT_WORKBENCH_INSTALL_SOURCE:-0}" != 1 ] &&
     [ -x "$attention_destination" ] &&
     [ "$($attention_destination --version 2>/dev/null | awk '{print $2}')" = "$attention_version" ]; then
    return 0
  fi

  attention_installed=0
  if [ "${TMUX_AGENT_WORKBENCH_INSTALL_SOURCE:-0}" != 1 ] &&
     [ -n "$attention_target" ] && command -v curl >/dev/null 2>&1; then
    attention_tmp=$(mktemp -d)
    attention_url="https://github.com/lukewang1024/tmux-agent-workbench/releases/download/v$attention_version/tmux-agent-workbench-$attention_target.tar.gz"
    if curl -fsSL "$attention_url" -o "$attention_tmp/archive.tar.gz" &&
       tar -xzf "$attention_tmp/archive.tar.gz" -C "$attention_tmp" &&
       [ -x "$attention_tmp/tmux-agent-workbench" ]; then
      install_attention_file "$attention_tmp/tmux-agent-workbench"
      attention_installed=1
      echo "installed release binary $attention_destination"
    fi
    rm -rf "$attention_tmp"
  fi

  if [ "$attention_installed" -eq 0 ]; then
    if ! command -v cargo >/dev/null 2>&1; then
      echo "install: no release asset and cargo is unavailable" >&2
      return 1
    fi
    echo "release binary unavailable; building tmux-agent-workbench from source"
    cargo build --manifest-path "$PLUGIN_DIR/Cargo.toml" --release --bin tmux-agent-workbench
    install_attention_file "$PLUGIN_DIR/target/release/tmux-agent-workbench"
  fi
}

install_attention_binary

# Back up a pre-existing non-symlink target to <name>~, then symlink. Skip if
# the correct symlink is already in place so re-runs don't churn backups.
link_one() {
  src="$1"
  dst="$BIN_DIR/$(basename "$src")"

  if [ -h "$dst" ]; then
    if [ "$(readlink "$dst")" = "$src" ]; then
      return 0                       # already correct — idempotent no-op
    fi
    rm "$dst"                        # stale symlink — repoint
  elif [ -e "$dst" ]; then
    mv "$dst" "$dst~"                # real file/dir — preserve as <name>~
  fi

  ln -s "$src" "$dst"
  echo "linked $dst -> $src"
}

# Layer 1 (agent/window model) — always.
for f in "$PLUGIN_DIR"/bin/*; do
  [ -f "$f" ] && [ -x "$f" ] && link_one "$f"
done

# Distributed Fabric integration remains a provider, not part of the Core.
for f in "$PLUGIN_DIR"/providers/*; do
  [ -f "$f" ] && [ -x "$f" ] && link_one "$f"
done

# Layer 2 (git-worktree workspaces) — unless --no-git.
if [ "$INCLUDE_GIT" -eq 1 ]; then
  for f in "$PLUGIN_DIR"/git/bin/*; do
    [ -f "$f" ] && [ -x "$f" ] && link_one "$f"
  done
fi

# Shared agent skills. ~/.agents/skills is the cross-tool discovery location;
# keep the real data under XDG and expose only the compatibility symlink there.
mkdir -p "$SKILL_DIR" "$HOME/.agents/skills"
for skill in "$PLUGIN_DIR"/skills/*; do
  [ -d "$skill" ] || continue
  name=$(basename "$skill")
  canonical="$SKILL_DIR/$name"
  if [ -h "$canonical" ]; then rm "$canonical"
  elif [ -e "$canonical" ]; then mv "$canonical" "$canonical~"
  fi
  ln -s "$skill" "$canonical"

  compat="$HOME/.agents/skills/$name"
  if [ -h "$compat" ]; then rm "$compat"
  elif [ -e "$compat" ]; then mv "$compat" "$compat~"
  fi
  ln -s "$canonical" "$compat"
  echo "linked $compat -> $canonical -> $skill"
done

#!/bin/sh
set -eu

self=$0
case $self in
  /*) ;;
  *) self=$(command -v "$self") ;;
esac
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
provider_dir=$(cd "$(dirname "$self")" && pwd -P)
layout_controller=$provider_dir/../bin/workbench-layout

usage() {
  echo "usage: workbench-tmux-provider <workspace.inspect|agent.launch|logs.open> ..." >&2
  exit 2
}

safe_name() {
  case $1 in
    ''|*[!A-Za-z0-9_.-]*) return 1 ;;
    *) return 0 ;;
  esac
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g'
}

command=${1:-}
[ "$#" -gt 0 ] && shift || true

case $command in
  workspace.inspect)
    [ "$#" -eq 2 ] || usage
    session=$1
    path=$2
    safe_name "$session" || { echo "invalid session: $session" >&2; exit 2; }
    [ -d "$path" ] || { echo "repository path not found: $path" >&2; exit 2; }
    WORKBENCH_SESSION=$session mux-inspect "$path" --force
    printf '{"provider":"tmux","capability":"workspace.inspect","session":"%s","path":"%s"}\n' \
      "$(json_escape "$session")" "$(json_escape "$path")"
    ;;
  agent.launch)
    [ "$#" -ge 3 ] || usage
    session=$1
    cwd=$2
    agent=$3
    shift 3
    safe_name "$session" || { echo "invalid session: $session" >&2; exit 2; }
    safe_name "$agent" || { echo "invalid agent executable: $agent" >&2; exit 2; }
    [ -d "$cwd" ] || { echo "agent cwd not found: $cwd" >&2; exit 2; }
    if tmux has-session -t "$session" 2>/dev/null; then
      echo "agent session already exists: $session" >&2
      exit 3
    fi
    tmux new-session -d -s "$session" -n agent -c "$cwd" "$agent" "$@"
    tmux set-option -t "$session" @workbench_task 1
    tmux set-option -t "$session" @workbench_provider distributed-workbench
    printf '{"provider":"tmux","capability":"agent.launch","session":"%s","cwd":"%s","agent":"%s"}\n' \
      "$(json_escape "$session")" "$(json_escape "$cwd")" "$(json_escape "$agent")"
    ;;
  logs.open)
    [ "$#" -ge 3 ] || usage
    session=$1
    window=$2
    shift 2
    safe_name "$session" || { echo "invalid session: $session" >&2; exit 2; }
    safe_name "$window" || { echo "invalid window: $window" >&2; exit 2; }
    first=$1
    shift
    [ -f "$first" ] || { echo "log not found: $first" >&2; exit 2; }
    if tmux has-session -t "$session" 2>/dev/null; then
      tmux new-window -d -t "$session" -n "$window" "tail -n 200 -F '$first'"
    else
      tmux new-session -d -s "$session" -n "$window" "tail -n 200 -F '$first'"
    fi
    target=$session:$window
    for log_path in "$@"; do
      [ -f "$log_path" ] || { echo "log not found: $log_path" >&2; exit 2; }
      tmux split-window -d -t "$target" "tail -n 200 -F '$log_path'"
    done
    active_pane=$(tmux list-panes -t "$target" \
      -f '#{!=:#{@pane_role},sidebar}' -F '#{pane_id} #{pane_active}' |
      awk '$2 == 1 { print $1; exit }')
    [ -n "$active_pane" ] || {
      echo "no log pane in $target" >&2
      exit 1
    }
    "$layout_controller" tiled "$active_pane"
    printf '{"provider":"tmux","capability":"logs.open","target":"%s"}\n' "$(json_escape "$target")"
    ;;
  *) usage ;;
esac

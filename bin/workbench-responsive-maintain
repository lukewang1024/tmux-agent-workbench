#!/bin/sh
set -eu

[ "$#" -eq 2 ] || exit 2
core=$1
client=$2
case $client in ''|*[!A-Za-z0-9_./-]*) exit 2 ;; esac
[ -x "$core" ] || exit 1

runtime=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
server_pid=$(tmux display-message -p '#{pid}')
lock=$runtime/workbench-responsive-$server_pid-$(printf '%s' "$client" | tr '/.' '__').lock
mkdir "$lock" 2>/dev/null || exit 0
trap 'rmdir "$lock" 2>/dev/null || true' EXIT HUP INT TERM

snapshot()
{
  # The -c flag of display-message is not a client-relative pane selector.
  # Keep all fields from one exact list-clients row, including height changes.
  row=$(tmux list-clients -F '#{client_name} #{session_id} #{window_id} #{pane_id} #{client_width} #{client_height} #{pane_width} #{pane_height}' |
    awk -v target="$client" '$1 == target { $1 = ""; sub(/^ /, ""); print; found = 1; exit } END { if (!found) exit 1 }') || return 1
  read -r session window pane width height pane_width pane_height <<EOF
$row
EOF
  case $session:$window:$pane in \$[0-9]*:@[0-9]*:%[0-9]*) ;; *) return 1 ;; esac
  case $width:$height:$pane_width:$pane_height in *[!0-9:]*|::*|*::*) return 1 ;; esac
  stamp=$session:$window:$pane:$width:$height:$pane_width:$pane_height

}

rounds=0
while [ "$rounds" -lt 8 ]; do
  rounds=$((rounds + 1))
  snapshot || exit 0
  before=$stamp
  "$core" sidebar-control maintain "$window"
  snapshot || exit 0
  [ "$before" = "$stamp" ] || continue
  "$(dirname "$0")/workbench-responsive-zoom" "$width" "$window"
  stable=$stamp
  snapshot || exit 0
  if [ "$stable" = "$stamp" ]; then
    "$core" client refresh --client "$client"
    exit 0
  fi
done

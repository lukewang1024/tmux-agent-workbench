#!/bin/sh
# Open a temporary tool. Closing it leaves no inspection window behind.
# Context variables are assigned by the sourced task-context helpers.
# shellcheck disable=SC2154
set -eu
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
dir=$(CDPATH='' cd -- "$(dirname "$self")" && pwd -P)
. "$dir/../lib/resolve-tools.sh"
. "$dir/../lib/resolve-session.sh"
. "$dir/../lib/task-context.sh"
usage() {
  echo 'usage: tmux-agent-workbench inspect <path> [--git|--editor|--shell] [--pane]' >&2
}
case ${1:-} in -h|--help) usage; exit 0 ;; esac
[ $# -ge 1 ] || { usage; exit 2; }
path=$1; shift
mode=git
pane_mode=0
for arg do
  case $arg in
    --git) mode=git ;;
    --editor) mode=editor ;;
    --shell) mode=shell ;;
    --pane) pane_mode=1 ;;
    --focus|--force) : ;; # compatibility; an explicit tool request is always honoured
    *) echo "tmux-agent-workbench inspect: unknown option: $arg" >&2; exit 2 ;;
  esac
done
path=$(CDPATH='' cd "$path" && pwd -P) || exit 1
caller=$(workbench_resolve_pane) || exit 1
session=$(tmux display-message -p -t "$caller" '#{session_id}')
if [ -n "$(tmux show-option -qv -t "$session" @workbench_workspace_root)" ] || \
   [ -n "$(tmux show-option -wqv -t "$caller" @workbench_task_root)" ]; then
  workbench_task_context
  path=$(workbench_task_repo "$path") || exit 1
  session=$wb_session
  [ -z "$wb_window" ] || caller=$(tmux list-panes -t "$wb_window" -f '#{!=:#{@pane_role},sidebar}' -F '#{pane_id}' | head -1)
fi
# Used by the sourced proxy-inheritance helper.
# shellcheck disable=SC2034
wb_session=$session
workbench_inherit_proxies
case $mode in
  git) command_string=$(resolve_git_tool) ;;
  editor) command_string=$(resolve_editor) ;;
  shell) command_string=${SHELL:-/bin/sh} ;;
esac
if [ "$pane_mode" = 0 ]; then
  set -- display-popup -t "$caller" -E -w 90% -h 90% -d "$path" -e "PATH=$PATH"
  [ -z "${WORKBENCH_TARGET_CLIENT:-}" ] || set -- "$@" -c "$WORKBENCH_TARGET_CLIENT"
  if [ -n "${wb_task:-}" ]; then
    set -- "$@" -e "WORKBENCH_SESSION=$wb_session" -e "WORKBENCH_TASK=$wb_task" -e "WORKBENCH_FEATURE=$wb_direction"
  fi
  exec tmux "$@" "$command_string"
fi
ready=workbench-tool-$$
set -- split-window -d -v -t "$caller" -c "$path" \
  -e "PATH=$PATH" -e "WORKBENCH_TOOL_COMMAND=$command_string" -e "WORKBENCH_TOOL_READY=$ready" -P -F '#{pane_id}'
if [ -n "${wb_task:-}" ]; then
  set -- "$@" -e "WORKBENCH_SESSION=$wb_session" -e "WORKBENCH_TASK=$wb_task" -e "WORKBENCH_FEATURE=$wb_direction"
fi
pane=$(tmux "$@" \
  'tmux wait-for "$WORKBENCH_TOOL_READY"; exec /bin/sh -c "$WORKBENCH_TOOL_COMMAND"')
tmux set-option -p -t "$pane" @pane_role tool
tmux set-option -p -t "$pane" remain-on-exit off
tmux wait-for -S "$ready"
printf '%s\n' "$pane"

#!/usr/bin/env python3
"""Optional botmux public-CLI adapter; never sends input to an agent pane."""
import os
from pathlib import Path
import re
import subprocess
import sys


def output(args, env=None):
    return subprocess.check_output(args, env=env, text=True, timeout=5).strip()


def connect(socket, pane, root, agent):
    # botmux deliberately drops TMUX and always discovers the default server.
    env = dict(os.environ)
    env.pop('TMUX', None)
    env.pop('TMUX_PANE', None)
    default = output(['tmux', 'display-message', '-p', '#{socket_path}'], env)
    if Path(default).resolve() != Path(socket).resolve():
        raise ValueError('botmux /adopt supports the default tmux server only; this pane uses a different socket.')
    command = ['tmux', '-S', socket]
    info = output(command + ['display-message', '-p', '-t', pane,
                            '#{pane_id}\n#{pane_pid}\n#{session_name}:#{window_index}.#{pane_index}'])
    lines = info.splitlines()
    if len(lines) != 3 or lines[:2] != [pane, root]:
        raise ValueError('Pane changed. Reopen the menu.')
    if not agent.isdigit():
        raise ValueError('No foreground agent. Reopen the Agent menu.')
    pid = agent
    visited = set()
    while pid != root:
        if pid in visited or not pid.isdigit() or int(pid) <= 1:
            raise ValueError('Agent changed. Reopen the menu.')
        visited.add(pid)
        pid = output(['ps', '-o', 'ppid=', '-p', pid])
    target = lines[2]
    # Slash commands must be a single unambiguous token.
    if not re.fullmatch(r'[A-Za-z0-9_.-]+:\d+\.\d+', target):
        raise ValueError('This session name cannot be safely copied into /adopt. Use the Feishu /adopt picker instead.')
    text = '/adopt ' + target
    subprocess.run(command + ['set-buffer', '-w', '--', text], check=True, timeout=5)
    print('\nCopied to tmux buffer (and client clipboard when supported):\n\n  ' + text)
    print('\nPaste it in a fresh topic with your configured Feishu bot.')
    print('The bot must use the same coding agent as this pane, with sandbox disabled.')
    print('Copying this command does not create a connection. Wait for the bot confirmation.')
    print('For parallel tasks, use a separate topic per pane; normally connect the team lead.')
    print('To disconnect, send /close in that topic. The local agent keeps running.')


def main():
    operation, socket, pane, root, agent = sys.argv[1:]
    if operation == 'connect':
        connect(socket, pane, root, agent)
    elif operation in {'setup', 'start', 'status', 'dashboard', 'list'}:
        args = ['botmux', operation]
        if operation == 'list':
            args.append('--plain')
        result = subprocess.run(args, check=False)
        if operation == 'list':
            print('\nDisconnect an adopted pane with /close in its Feishu topic.')
            print('This preserves the local agent. Each topic has its own connection.')
        if result.returncode:
            print('\nbotmux exited with status', result.returncode)
    else:
        raise ValueError('Unsupported operation')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError) as exc:
        print('\nBotmux: ' + str(exc), file=sys.stderr)
    finally:
        try:
            input('\nPress Enter to close...')
        except (EOFError, KeyboardInterrupt):
            pass

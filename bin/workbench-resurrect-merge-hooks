#!/bin/sh
set -eu

# Merge the native Workbench lifecycle-hook identities into the compatible
# assistant-resurrect sidecar. This makes the Workbench hook the authority for
# Claude, Codex, and OpenCode while retaining the detector fallback
# for assistants that do not have a Workbench hook target.

wb_tmux() {
	if [ -n "${TMUX_AGENT_WORKBENCH_TMUX_SOCKET:-}" ]; then
		tmux -S "$TMUX_AGENT_WORKBENCH_TMUX_SOCKET" "$@"
	else
		tmux "$@"
	fi
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/../lib/assistant-sessions/paths.sh"
resurrect_dir=$(workbench_resurrect_dir)
input_file=$resurrect_dir/assistant-sessions.json
[ -f "$input_file" ] || { printf '%s\n' 'workbench resurrect: assistant sidecar is missing' >&2; exit 1; }

snapshot=$("$script_dir/tmux-agent-workbench-cli" snapshot --json 2>/dev/null) || {
	printf '%s\n' 'workbench resurrect: could not read native assistant identities' >&2
	exit 1
}
[ -n "$snapshot" ] || { printf '%s\n' 'workbench resurrect: empty native snapshot' >&2; exit 1; }

overlay=$(mktemp)
output=$(mktemp "${input_file}.workbench.XXXXXX")
trap 'rm -f "$overlay" "$output"' EXIT HUP INT TERM

if ! printf '%s\n' "$snapshot" | jq -ce '
	if type != "object" or ((.agents // []) | type) != "array" then
		error("invalid Workbench snapshot")
	else
		[.agents[]
		 | select((.hook_session_id // "") != "")
		 | select(.kind == "claude" or .kind == "codex" or .kind == "opencode")
		 | select((.target.pane_id // "") != "")
		 | {
			pane: ([(.target.session_name // ""), ":", ((.target.window_index // 0) | tostring), ".", ((.target.pane_index // 0) | tostring)] | add),
			tool: .kind,
			session_id: .hook_session_id,
			cwd: "",
			pid: ((.process.pid // 0) | tostring),
			model: "",
			cli_args: "",
			env: null,
			copilot_home: "",
			session_name: (.target.session_name // ""),
			window_index: ((.target.window_index // 0) | tostring),
			pane_index: ((.target.pane_index // 0) | tostring)
		}
		]
	end
' >"$overlay"; then
	printf '%s\n' 'workbench resurrect: invalid native snapshot' >&2
	exit 1
fi

overlay_count=$(jq 'length' "$overlay")
[ "$overlay_count" -gt 0 ] || exit 0

# Overlay only the identity for a unique detector entry. Its saved options,
# environment and cwd must survive, and duplicates must remain ambiguous.
if jq --slurpfile workbench "$overlay" '
	if type != "object"
	   or ((.sessions // []) | type) != "array"
	   or ((.relaunch // []) | type) != "array"
	then error("invalid assistant sidecar")
	else
		.sessions = ((.sessions // [])
			| reduce ($workbench[0] | group_by([.pane, .tool])[]) as $group (. ;
				$group[0] as $new |
				[ to_entries[] | select(.value.pane == $new.pane and .value.tool == $new.tool) | .key ] as $matches
				| if ($group | length) > 1 then
				    if ($matches | length) >= 2 then . else . + $group end
				  elif ($matches | length) == 0 then . + [$new]
				  elif ($matches | length) == 1 then .[$matches[0]].session_id = $new.session_id
				  else . end))
	end
' "$input_file" >"$output"; then
	mv -f "$output" "$input_file"
	printf '%s\n' "tmux-agent-workbench: merged $overlay_count native hook session(s) into $input_file" >&2
else
	printf '%s\n' 'workbench resurrect: invalid assistant sidecar; native identities were not merged' >&2
	exit 1
fi

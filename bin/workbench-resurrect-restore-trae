#!/bin/sh
set -eu

wb_tmux() {
	if [ -n "${TMUX_AGENT_WORKBENCH_TMUX_SOCKET:-}" ]; then
		tmux -S "$TMUX_AGENT_WORKBENCH_TMUX_SOCKET" "$@"
	else
		tmux "$@"
	fi
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/../lib/assistant-sessions/paths.sh"
resurrect_dir=$(workbench_resurrect_dir)
input="$resurrect_dir/workbench-trae-sessions.json"

[ -f "$input" ] || exit 0
command -v jq >/dev/null 2>&1 || { printf '%s\n' 'workbench resurrect: jq is required for Trae restore' >&2; exit 1; }
sleep 2

entries=$(mktemp "${TMPDIR:-/tmp}/workbench-trae-entries.XXXXXX")
trap 'rm -f "$entries"' EXIT HUP INT TERM
if [ ! -s "$input" ] || ! jq -c 'if type == "array" then .[] else error("invalid Trae sidecar") end' "$input" >"$entries" 2>/dev/null; then
	printf '%s\n' 'workbench resurrect: invalid Trae sidecar' >&2
	exit 1
fi

while IFS= read -r entry; do
	session_id=$(printf '%s\n' "$entry" | jq -r '.session_id // empty')
	session_name=$(printf '%s\n' "$entry" | jq -r '.session_name // empty')
	window_index=$(printf '%s\n' "$entry" | jq -r '.window_index // empty')
	pane_index=$(printf '%s\n' "$entry" | jq -r '.pane_index // empty')
	case "$session_id" in
	''|*[!A-Za-z0-9._:/+=-]*) continue ;;
	esac
	[ -n "$session_name" ] && [ -n "$window_index" ] && [ -n "$pane_index" ] || continue

	separator=$(printf '\t')
	pane_id=$(wb_tmux list-panes -a -F "#{session_name}${separator}#{window_index}${separator}#{pane_index}${separator}#{pane_id}" 2>/dev/null |
		awk -F "$separator" -v session="$session_name" -v window="$window_index" -v pane="$pane_index" \
			'$1 == session && $2 == window && $3 == pane { print $4; exit }')
	[ -n "$pane_id" ] || continue
	if [ -n "$(wb_tmux show-option -pqv -t "$pane_id" @workbench_team_resume_blocked 2>/dev/null || true)" ]; then
		continue
	fi

	client_wait=0
	while [ "$(wb_tmux list-clients -t "$pane_id" 2>/dev/null | wc -l | tr -d ' ')" -eq 0 ] && [ "$client_wait" -lt 50 ]; do
		sleep 0.1
		client_wait=$((client_wait + 1))
	done

	pane_cmd=$(wb_tmux display-message -t "$pane_id" -p '#{pane_current_command}' 2>/dev/null || true)
	pane_cmd=${pane_cmd#-}
	case "$pane_cmd" in
	trae|traex|trae-cli|traecode)
		continue
		;;
	bash|zsh|fish|sh|dash|ksh|tcsh|csh|nu)
		;;
	*)
		continue
		;;
	esac
	team_member=$(wb_tmux show-option -pqv -t "$pane_id" @agent_team_member 2>/dev/null || true)
	if [ -n "$team_member" ]; then
		helper=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/workbench-resurrect-team
		quoted_helper=$(printf '%s' "$helper" | sed "s/'/'\\\\''/g")
		case "$pane_cmd" in
		nu) team_launcher='^env' ;;
		csh|tcsh) team_launcher='\env' ;;
		*) team_launcher='env' ;;
		esac
		wb_tmux send-keys -t "$pane_id" "$team_launcher python3 '$quoted_helper' resume '$pane_id' '$session_id'" C-m
	else
		wb_tmux send-keys -t "$pane_id" "command traex --resume $session_id" C-m
	fi
done <"$entries"

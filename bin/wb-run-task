#!/bin/sh
# A service is a supporting pane in its owning task's window.
# Context variables are assigned by the sourced task-context helpers.
# shellcheck disable=SC2154
set -eu
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
dir=$(CDPATH='' cd -- "$(dirname "$self")" && pwd -P)
. "$dir/../lib/resolve-session.sh"
. "$dir/../lib/task-context.sh"
label=task
if [ "${1:-}" = --name ]; then
  [ $# -ge 3 ] || exit 2
  label=$2; shift 2
fi
[ $# -eq 2 ] || { echo 'usage: tmux-agent-workbench run [--name <label>] <path> <command>' >&2; exit 2; }
path=$1
command_string=$2
workbench_task_context
[ -n "$wb_window" ] || { echo 'workbench: reopen this task with task new before running a service.' >&2; exit 1; }
path=$(workbench_task_repo "$path") || exit 1
window=$wb_window
lock=workbench-run-$window
tmux wait-for -L "$lock"
trap 'tmux wait-for -U "$lock" 2>/dev/null || true' 0
trap 'exit 1' HUP INT TERM
workbench_inherit_proxies
pane=
for candidate in $(tmux list-panes -t "$window" -F '#{pane_id}'); do
  [ "$(tmux show-option -pqv -t "$candidate" @pane_role)" = task ] || continue
  [ "$(tmux show-option -pqv -t "$candidate" @workbench_task_name)" = "$label" ] || continue
  pane=$candidate
  break
done
ready=workbench-run-$$
if [ -n "$pane" ]; then
  tmux respawn-pane -k -t "$pane" -c "$path" \
    -e "PATH=$PATH" -e "WORKBENCH_TASK_COMMAND=$command_string" -e "WORKBENCH_TASK_READY=$ready" \
    -e "WORKBENCH_SESSION=$wb_session" -e "WORKBENCH_TASK=$wb_task" -e "WORKBENCH_FEATURE=$wb_direction" \
    'tmux wait-for "$WORKBENCH_TASK_READY"; exec /bin/sh -c "$WORKBENCH_TASK_COMMAND"'
else
  anchor=$(tmux list-panes -t "$window" -f '#{!=:#{@pane_role},sidebar}' -F '#{pane_id}' | head -1)
  pane=$(tmux split-window -d -v -t "$anchor" -c "$path" \
    -e "PATH=$PATH" -e "WORKBENCH_TASK_COMMAND=$command_string" -e "WORKBENCH_TASK_READY=$ready" \
    -e "WORKBENCH_SESSION=$wb_session" -e "WORKBENCH_TASK=$wb_task" -e "WORKBENCH_FEATURE=$wb_direction" \
    -P -F '#{pane_id}' \
    'tmux wait-for "$WORKBENCH_TASK_READY"; exec /bin/sh -c "$WORKBENCH_TASK_COMMAND"')
fi
tmux set-option -p -t "$pane" @pane_role task
tmux set-option -p -t "$pane" remain-on-exit off
tmux set-option -p -t "$pane" @workbench_task_name "$label"
tmux set-option -p -t "$pane" @workbench_task_command "$command_string"
tmux set-option -p -t "$pane" @workbench_project_root "$path"
tmux select-pane -t "$pane" -T "$label"
[ -z "${ready:-}" ] || tmux wait-for -S "$ready"
printf '%s\n' "$pane"

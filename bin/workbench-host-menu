#!/bin/sh
set -eu

client=${1:-}
pane=${2:-}
case $client in ''|*[!A-Za-z0-9_./-]*) exit 2 ;; esac
case $pane in
  '%'|''|%*[!0-9]*) exit 2 ;;
  %*) ;;
  *) exit 2 ;;
esac

command -v ssh-connect >/dev/null 2>&1 || {
  tmux display-message -c "$client" 'ssh-connect is unavailable'
  exit 127
}

self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
script_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd -P)
mouse_mode=$("$script_dir/workbench-menu-mouse-mode" "$client" 2>/dev/null || printf '%s\n' mouse)
set -- "$script_dir/tmux-agent-workbench-cli" display-menu -- -M
[ "$mouse_mode" != mouse ] || set -- "$@" -O
# Older tmux silently omits a menu whose title exceeds the client width.
# It also counts title style directives toward that limit. Use plain text
# and leave room for the UTF-8 icon, trim marker, SSH label and borders.
set -- "$@" -C 0 -c "$client" -t "$pane" \
  -T ' 󰍹 #{=/#{e|-:#{client_width},20}/…:host} · SSH '
found=0
keys=123456789abcdefghijklmnopqrstuvwxyz
index=1
while IFS= read -r host; do
  [ -n "$host" ] || continue
  key=$(printf '%s' "$keys" | cut -c "$index")
  [ -n "$key" ] || break
  quoted=$(printf '%s' "$host" | sed "s/'/'\\\\''/g")
  set -- "$@" "$host" "$key" \
    "new-window -c \"#{pane_current_path}\" -n '$quoted' \"exec ssh-connect connect '$quoted'\""
  found=1
  index=$((index + 1))
done <<EOF
$(ssh-connect hosts list)
EOF

if [ "$found" -eq 0 ]; then
  tmux display-message -c "$client" 'ssh-connect has no configured hosts'
  exit 1
fi
exec "$@"

#!/bin/sh
set -eu

client=${1:-}
pane=${2:-}
case $client in ''|*[!A-Za-z0-9_./-]*) exit 2 ;; esac
case $pane in
  '%'|''|%*[!0-9]*) exit 2 ;;
  %*) ;;
  *) exit 2 ;;
esac

command -v ssh-connect >/dev/null 2>&1 || {
  tmux display-message -c "$client" 'ssh-connect is unavailable'
  exit 127
}

set -- tmux display-menu -M -O -C 0 -c "$client" -t "$pane" \
  -T '#[align=centre] 󰍹 SSH '
found=0
keys=123456789abcdefghijklmnopqrstuvwxyz
index=1
while IFS= read -r host; do
  [ -n "$host" ] || continue
  key=$(printf '%s' "$keys" | cut -c "$index")
  [ -n "$key" ] || break
  quoted=$(printf '%s' "$host" | sed "s/'/'\\\\''/g")
  set -- "$@" "$host" "$key" \
    "new-window -c \"#{pane_current_path}\" -n '$quoted' \"exec ssh-connect connect '$quoted'\""
  found=1
  index=$((index + 1))
done <<EOF
$(ssh-connect hosts list)
EOF

if [ "$found" -eq 0 ]; then
  tmux display-message -c "$client" 'ssh-connect has no configured hosts'
  exit 1
fi
exec "$@"

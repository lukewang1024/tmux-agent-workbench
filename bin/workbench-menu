#!/bin/sh
# Compatibility entrypoint; statusbar and keyboard share the Rust menu.
set -eu
kind=${1:-}
client=${2:-}
pane=${3:-}
case $client in ''|*[!A-Za-z0-9_./-]*) exit 2 ;; esac
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
script_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd -P)
[ -n "$pane" ] || pane=$(tmux display-message -p -c "$client" '#{pane_id}')
exec "$script_dir/workbench-status-popup" "$kind" "$client" "$pane"

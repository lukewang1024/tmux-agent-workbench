#!/bin/sh
# Compatibility entry point; all new callers use tmux-agent-workbench.
set -eu
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
dir=$(CDPATH='' cd -- "$(dirname "$self")" && pwd -P)
. "$dir/../lib/deprecation.sh"
label=task
if [ "${1:-}" = --name ]; then
  [ $# -ge 3 ] || { echo 'usage: tmux-agent-workbench run [--name <label>] <repo> --shell <command>' >&2; exit 2; }
  label=$2
  shift 2
fi
[ $# -ge 2 ] || { echo 'usage: tmux-agent-workbench run [--name <label>] <repo> --shell <command>' >&2; exit 2; }
repo=$1
shift
exec "$dir/tmux-agent-workbench-cli" run --name "$label" "$repo" --shell "$*"

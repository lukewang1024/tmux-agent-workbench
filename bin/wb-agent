#!/bin/sh
# tmux-agent-workbench agent start --managed — launch the task's coding agent in the current directory.
#
# A workspace session groups a direction; each window is a separate task.
# The selected CLI comes from WORKBENCH_AGENT. Repositories are attached to the
# task with `add`, using isolated worktrees, without opening additional windows.
# The workspace launcher handles durable task ownership before starting us.
#
# usage: tmux-agent-workbench agent start --managed [extra args passed through to the agent]
#        WORKBENCH_AGENT=codex tmux-agent-workbench agent start --managed      # override per session/pane
set -eu

exec_codex()
{
  for arg do
    case $arg in
      --team|--approve-for-me|--yolo|--dangerously-bypass-approvals-and-sandbox|-a|--ask-for-approval|--ask-for-approval=*)
        exec agent-team start codex "$@"
        ;;
    esac
  done
  exec agent-team start codex --approve-for-me "$@"
}

exec_claude()
{
  for arg do
    case $arg in
      --) break ;;
      --team|--permission-mode|--permission-mode=*|--dangerously-skip-permissions)
        exec agent-team start claude "$@"
        ;;
    esac
  done
  exec agent-team start claude --permission-mode auto "$@"
}

exec_trae()
{
  for arg do
    case $arg in
      --team|--permission-mode|--permission-mode=*|-y|--yolo|--dangerously-bypass-approvals-and-sandbox)
        exec agent-team start traex "$@"
        ;;
    esac
  done
  exec agent-team start traex --permission-mode auto "$@"
}

exec_opencode()
{
  for arg do
    case $arg in
      --) break ;;
      --team|--auto)
        exec agent-team start opencode "$@"
        ;;
    esac
  done
  exec agent-team start opencode --auto "$@"
}

# Retain the managed-session marker for compatibility and legacy cleanup.
# Task ownership lives on @workbench_task_root on each window.
if [ "${WORKBENCH_MANAGED:-1}" = 1 ] && [ -n "${TMUX:-}" ]; then
  tmux set-option @workbench_task 1 2>/dev/null || true
fi

case ${1:-} in
  codex|claude|traex|trae|opencode)
    WORKBENCH_AGENT=$1
    shift
    ;;
esac
agent=${WORKBENCH_AGENT:-claude}
[ "$agent" != traex ] || agent=trae
WORKBENCH_AGENT=$agent
WORKBENCH_PROFILE=${WORKBENCH_PROFILE:-$agent-default}
export WORKBENCH_AGENT WORKBENCH_PROFILE

# Tool runners may sanitize their child environment before invoking commands.
# Keep the launch identity on the pane as durable tmux metadata so commands
# such as tmux-agent-workbench agent handoff can recover it after locating the calling pane.
if [ -n "${TMUX_PANE:-}" ]; then
  tmux set-option -p -t "$TMUX_PANE" @workbench_agent "$WORKBENCH_AGENT" 2>/dev/null || true
  tmux set-option -p -t "$TMUX_PANE" @workbench_profile "$WORKBENCH_PROFILE" 2>/dev/null || true
fi
case $agent in
  claude)   exec_claude "$@" ;;
  codex)    exec_codex "$@" ;;
  trae)     exec_trae "$@" ;;
  opencode) exec_opencode "$@" ;;
  *)
    echo "tmux-agent-workbench agent start --managed: unknown WORKBENCH_AGENT='$agent' (want claude|codex|trae|opencode)" >&2
    exit 2
    ;;
esac

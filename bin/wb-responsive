#!/bin/sh
set -eu

self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
plugin_dir=$(CDPATH='' cd -- "$(dirname "$self")/.." && pwd -P)
. "$plugin_dir/lib/resolve-core.sh"
core=$(workbench_core_path "$plugin_dir") || core=
[ -n "$core" ] || { tmux display-message "Workbench binary unavailable"; exit 1; }

# tmux run-shell does not guarantee that TMUX is present in the child
# environment. The core accepts an explicit socket and should use the same
# server this launcher is already controlling through the tmux CLI.
TMUX_AGENT_WORKBENCH_TMUX_SOCKET=$(tmux display-message -p '#{socket_path}')
export TMUX_AGENT_WORKBENCH_TMUX_SOCKET

client=${2:-}
if [ -z "$client" ]; then
  client=$(tmux list-clients -F '#{client_name} #{window_id}' | \
    awk -v target="${1:-}" '$2 == target { print $1; found = 1; exit } END { if (!found) exit 1 }') || true
fi
if [ -z "$client" ] && [ "$(tmux list-clients -F '#{client_name}' | wc -l | tr -d ' ')" -eq 1 ]; then
  client=$(tmux list-clients -F '#{client_name}')
fi
case $client in
  ''|*[!A-Za-z0-9_./-]*) tmux display-message 'Workbench client unavailable'; exit 1 ;;
esac
# run-shell format expansion may supply a stale window from another session.
# Resolve the client-owned session first; ordinary window_id/session_id formats
# still use tmux's default target pane even when display-message has -c.
client_session=$(tmux display-message -p -c "$client" '#{client_session}') || {
  tmux display-message 'Workbench client unavailable'
  exit 1
}
window=$(tmux display-message -p -t "$client_session:" '#{window_id}') || exit 1
source_pane=$(tmux display-message -p -t "$window" '#{pane_id}') || exit 1
viewport_width=$(tmux list-clients -F '#{client_name} #{window_id} #{client_width}' | \
  awk -v target="$client" -v window="$window" '
    $1 == target && $2 == window { found = 1 }
    $2 == window { if (width == "" || $3 < width) width = $3 }
    END { if (found) print width; else exit 1 }
  ') || {
  tmux display-message -c "$client" 'Workbench client disappeared'
  exit 1
}
window_width=$(tmux display-message -p -t "$window" '#{window_width}') || exit 1
sidebar_width=$(tmux show-option -gqv @sidebar_width)
main_width=$(tmux show-option -gqv @sidebar_main_min_width)
sidebar_width=${sidebar_width:-26}
main_width=${main_width:-80}

threshold=$((sidebar_width + main_width + 1))
if [ "$viewport_width" -ge "$threshold" ] && [ "$window_width" -ge "$threshold" ]; then
  exec "$core" sidebar-control toggle "$window"
fi

"$core" sidebar-control maintain "$window" >/dev/null 2>&1 || true
tmux set-option -q @workbench_overlay_visible 1
trap 'tmux set-option -qu @workbench_overlay_visible; "$core" sidebar-control maintain "$window" >/dev/null 2>&1 || true' EXIT HUP INT TERM
popup_status=0
"$core" sidebar --popup --pane "$source_pane" --client "$client" || popup_status=$?

# tmux reports a popup closed by HUP/INT as 128 + signal. Escape, Ctrl-C,
# navigation, and a disappearing client can all take this normal close path;
# do not make the foreground run-shell surface it as a command failure.
case $popup_status in
  0|129|130) exit 0 ;;
  *) exit "$popup_status" ;;
esac

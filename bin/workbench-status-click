#!/bin/sh
set -eu

range=${1:-}
pane=${2:-}
key_table=${3:-root}
client=${4:-}
window=${5:-}
script_dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd -P)

after_mouse_release()
{
  sleep "${WORKBENCH_STATUS_MOUSE_DELAY:-0.15}"
}

if [ "$(tmux show-option -gqv @workbench-status-click-debug 2>/dev/null || true)" = on ]; then
  state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
  log_dir=$state_home/tmux-agent-workbench
  mkdir -p "$log_dir"
  printf '%s range=%s pane=%s table=%s client=%s window=%s\n' \
    "$(date +%s)" "$range" "$pane" "$key_table" "$client" "$window" \
    >>"$log_dir/status-click-events.log"
fi

case $range in
  wb_prefix)
    if [ "$key_table" = prefix ]; then
      exec tmux send-prefix -t "$pane"
    fi
    exec tmux switch-client -c "$client" -T prefix
    ;;
  wb_tmux)
    after_mouse_release
    exec "$script_dir/workbench-menu" tmux "$client"
    ;;
  wb_agent)
    after_mouse_release
    exec "$script_dir/workbench-menu" agent "$client"
    ;;
  wb_sidebar)
    after_mouse_release
    exec "$script_dir/wb-responsive" "$window" "$client"
    ;;
  wb_host)
    after_mouse_release
    exec "$script_dir/workbench-host-menu" "$client" "$pane"
    ;;
  wb_usage)
    after_mouse_release
    exec "$script_dir/workbench-agent-usage" menu "$client"
    ;;
  *)
    [ -z "$window" ] || exec tmux select-window -t "$window"
    exit 0
    ;;
esac

#!/bin/sh
set -eu

range=${1:-}
pane=${2:-}
key_table=${3:-root}
client=${4:-}
window=${5:-}
script_dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd -P)

case $range in
  workbench_prefix)
    if [ "$key_table" = prefix ]; then
      exec tmux send-prefix -t "$pane"
    fi
    exec tmux switch-client -c "$client" -T prefix
    ;;
  workbench_tmux)
    exec "$script_dir/workbench-menu" tmux "$client"
    ;;
  workbench_agent)
    exec "$script_dir/workbench-menu" agent "$client"
    ;;
  workbench_sidebar)
    exec "$script_dir/wb-responsive" "$window" "$client"
    ;;
  workbench_host)
    exec "$script_dir/workbench-host-menu" "$client" "$pane"
    ;;
  agent_status)
    exec workbench-agent-usage menu
    ;;
  *) exit 0 ;;
esac

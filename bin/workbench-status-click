#!/bin/sh
set -eu

range=${1:-}
pane=${2:-}
key_table=${3:-root}
client=${4:-}
window=${5:-}
script_dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd -P)

if [ "$(tmux show-option -gqv @workbench-status-click-debug 2>/dev/null || true)" = on ]; then
  state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
  log_dir=$state_home/tmux-agent-workbench
  mkdir -p "$log_dir"
  printf '%s range=%s pane=%s table=%s client=%s window=%s\n' \
    "$(date +%s)" "$range" "$pane" "$key_table" "$client" "$window" \
    >>"$log_dir/status-click-events.log"
fi

case $range in
  wb_prefix)
    exec "$script_dir/wb-responsive" "$window" "$client"
    ;;
  wb_tmux)
    exec "$script_dir/workbench-status-popup" tmux "$client" "$pane"
    ;;
  wb_agent)
    exec "$script_dir/workbench-status-popup" agent "$client" "$pane" --focus-agent
    ;;
  wb_sidebar)
    exec "$script_dir/wb-responsive" "$window" "$client"
    ;;
  wb_host)
    exec "$script_dir/workbench-status-popup" host "$client" "$pane"
    ;;
  wb_usage)
    exec "$script_dir/workbench-agent-usage" menu "$client"
    ;;
  window)
    [ -z "$window" ] || exec tmux select-window -t "$window"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac

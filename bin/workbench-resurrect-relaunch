#!/usr/bin/env python3
"""Inspect and authorize the existing session-less relaunch voucher."""
import json
import os
from pathlib import Path
import subprocess
import sys
from datetime import datetime, timezone

LIB = Path(__file__).resolve().parent.parent / 'lib/assistant-sessions/scripts/lib-detect.sh'
SAVE = LIB.parent / 'save-assistant-sessions.sh'
HAZARDS = {'--dangerously-skip-permissions', '--dangerously-bypass-approvals-and-sandbox',
           '--allow-all', '--yolo', '--full-auto', '--cloud', '--environment', '--worktree', '--bare'}


def adapter(function, *args):
    env = dict(os.environ)
    if env.get('TMUX_AGENT_WORKBENCH_TMUX_SOCKET'):
        env['TMUX'] = env['TMUX_AGENT_WORKBENCH_TMUX_SOCKET'] + ',0,0'
    return subprocess.run(['bash', '-c', 'source "$1"; shift; "$@"', 'workbench', str(LIB),
                           function, *args], env=env, text=True, capture_output=True, check=False)


def path_for(function):
    result = adapter(function)
    value = result.stdout.rstrip('\n')
    if result.returncode or not value:
        raise RuntimeError('could not resolve resurrect data directory')
    return Path(value)


def ledger():
    path = path_for('resurrect_data_dir') / 'assistant-relaunch-candidates.json'
    if not path.exists():
        return path, []
    data = json.loads(path.read_text())
    if not isinstance(data, list):
        raise ValueError('invalid relaunch candidate ledger')
    return path, [item for item in data if isinstance(item, dict)]


def seed(voucher):
    voucher.parent.mkdir(parents=True, exist_ok=True)
    try:
        fd = os.open(voucher, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return False
    with os.fdopen(fd, 'w') as stream:
        stream.write('# Workbench session-less relaunch vouchers\n'
                     '# One canonical command per line; comments are ignored.\n')
    return True


def main(args):
    if args == ['clean']:
        result = subprocess.run(['bash', '-c', 'source "$1"; reap_stale_state_files',
                                 'workbench', str(SAVE)], check=False)
        if result.returncode:
            raise RuntimeError('could not clean stale assistant state')
        return
    if args == ['status']:
        directory = path_for('resurrect_data_dir')
        sidecar = directory / 'assistant-sessions.json'
        if not sidecar.is_file():
            print('No saved assistant sessions yet')
            return
        data = json.loads(sidecar.read_text())
        sessions = data.get('sessions', [])
        if not isinstance(sessions, list):
            raise ValueError('invalid assistant sidecar')
        print('Last save: {} ({} session(s))'.format(data.get('timestamp', '?'), len(sessions)))
        for entry in sessions:
            if isinstance(entry, dict):
                print('  {} in {}: {}'.format(entry.get('tool', '?'), entry.get('pane', '?'),
                                              entry.get('session_id', '?')))
        return
    if args == ['candidates']:
        _, entries = ledger()
        if not entries:
            print('No relaunch candidates observed yet.')
        for item in sorted(entries, key=lambda x: (x.get('seen', 0), x.get('longest_seconds', 0)), reverse=True):
            print('{}\t{}s\t{}'.format(item.get('seen', 0), item.get('longest_seconds', 0), item.get('cmd', '')))
        return
    voucher = path_for('relaunch_voucher_file')
    if args == ['seed']:
        print(('Created empty voucher: ' if seed(voucher) else 'Voucher already exists: ') + str(voucher))
        return
    if len(args) in (2, 3) and args[0] == 'add' and (len(args) == 2 or args[2] == '--force'):
        requested = args[1]
        path, entries = ledger()
        matches = [item for item in entries if item.get('cmd') == requested]
        if not matches:
            raise ValueError('command is absent from ' + str(path))
        tool = str(matches[0].get('tool', ''))
        canonical = adapter('relaunch_canon', tool, requested)
        shape = adapter('relaunch_shape_ok', requested)
        if canonical.returncode or canonical.stdout.rstrip('\n') != requested or shape.returncode:
            raise ValueError('ledger entry is not a canonical relaunch candidate')
        if any(token.split('=', 1)[0] in HAZARDS for token in requested.split()) and len(args) != 3:
            raise ValueError('command requires review; pass --force after the exact command to authorize it')
        seed(voucher)
        if requested in voucher.read_text().splitlines():
            print('Already vouched: ' + requested)
            return
        os.chmod(voucher, 0o600)
        with voucher.open('a') as stream:
            stream.write('\n# added {} via Workbench\n{}\n'.format(
                datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'), requested))
        print('Vouched: ' + requested)
        return
    raise ValueError('usage: resurrect relaunch candidates|seed|add <command> [--force]')


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except (OSError, ValueError, RuntimeError) as exc:
        print('workbench resurrect: ' + str(exc), file=sys.stderr)
        sys.exit(1)

#!/bin/sh
# Remove ephemeral Workbench sidebars from a tmux-resurrect layout snapshot.
set -eu

save_file=${1:?tmux-resurrect save file is required}
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/workbench-resurrect.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM

panes_file=$tmp_dir/panes
output_file=$tmp_dir/output
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tab=$(printf '\t')

if [ -n "${TMUX_AGENT_WORKBENCH_TMUX_SOCKET:-}" ]; then
  t() { command tmux -S "$TMUX_AGENT_WORKBENCH_TMUX_SOCKET" "$@"; }
else
  t() { command tmux "$@"; }
fi

t list-panes -a -f '#{==:#{@pane_role},sidebar}' \
  -F "#{session_name}${tab}#{window_index}${tab}#{pane_index}${tab}#{pane_id}" > "$panes_file"

awk -F '\t' -v OFS='\t' -f "$script_dir/../lib/resurrect-layout.awk" \
  "$panes_file" "$save_file" > "$output_file"

mv "$output_file" "$save_file"

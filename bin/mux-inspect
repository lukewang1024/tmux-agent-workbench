#!/bin/sh
# mux-inspect — add (or focus) a per-repo inspection window in the current tmux
# session: three panes stacked even-vertical, cwd = the repo in all of them —
# a git TUI on top (tig by default; WORKBENCH_GIT_TOOL=lazygit to swap it), an
# empty scratchpad shell in the middle (lands here), an editor on the bottom
# ($VISUAL/$EDITOR if set, else nvim falling back to vim).
#
# This is the single, agent-agnostic entry point for bringing a repo into a task
# session under the window-per-role model. A task == one session with one agent
# window; each repo the task touches gets its own full-screen inspection window,
# created lazily. Two callers:
#
#   - the prefix+G picker (mux-inspect-pick): manual — pick a repo, --focus to it.
#   - the coding agent itself, per the AGENTS.md / CLAUDE.md convention, when its
#     work reaches into another repo. There is no reliable cross-agent signal for
#     "the agent just gained a directory" (Claude's /add-dir fires no hook; codex
#     and opencode have none either), so we invert control: the agent announces a
#     scope change by running this command. Created detached by default so the
#     window appears without stealing focus.
#
# Growing the agent's own write scope is the agent's job, not this command's
# (claude: /add-dir; codex: reads by default, relaunch with --add-dir to write;
# opencode: references / external_directory). See mux-agent.
#
# The window-per-role model is opt-in per session: only sessions launched as a
# task workbench (marked with @workbench_task by mux-agent) get inspection
# windows. In any other session — a bare agent in an ad-hoc session, or the
# human's everyday session — this no-ops, so the agent-driven convention never
# appends surprise windows where they don't belong. Pass --force to override
# (the manual prefix+G picker does, since an explicit human pick is always
# honoured and is one way to turn an ordinary session into a workbench).
#
# usage: mux-inspect <repo-path> [--focus] [--force]
#        WORKBENCH_SESSION=<name> mux-inspect ...   # target a session other
#          than the caller's current one — e.g. a just-created, not-yet-attached
#          session (used by ws-add). Skips the "am I inside tmux" requirement
#          too, since the caller doesn't need to be attached to what it's
#          naming explicitly.
set -eu

# Resolve $0 through symlinks so sibling dirs (lib/, bin/) resolve even when the
# script is invoked via a PATH symlink (e.g. ~/.local/bin/<name>).
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
dir=$(cd "$(dirname "$self")" && pwd -P)
. "$dir/../lib/deprecation.sh"

. "$dir/../lib/resolve-tools.sh"

[ $# -ge 1 ] || { echo "usage: mux-inspect <repo-path> [--focus] [--force]" >&2; exit 2; }
path=$1; shift
focus=0
force=0
for a in "$@"; do
  case $a in
    --focus) focus=1 ;;
    --force) force=1 ;;
    *) echo "mux-inspect: unknown arg: $a" >&2; exit 2 ;;
  esac
done

sess=${WORKBENCH_SESSION:-}
if [ -z "$sess" ]; then
  [ -n "${TMUX:-}" ] || { echo "mux-inspect: not inside a tmux session (or set WORKBENCH_SESSION)" >&2; exit 1; }
  sess=$(tmux display-message -p '#S')
fi

# Gate on the workbench marker unless forced. exit 0 (not an error): the agent
# calls this speculatively per the AGENTS.md convention, and a non-workbench
# session is a normal, expected state — not a failure to retry or report.
if [ "$force" = 0 ] && [ "$(tmux show-option -t "$sess" -qv @workbench_task)" != 1 ]; then
  echo "mux-inspect: not a task workbench session (no @workbench_task); skipping — pass --force to override" >&2
  exit 0
fi
path=$(cd "$path" 2>/dev/null && pwd -P) || { echo "mux-inspect: no such dir: $1" >&2; exit 1; }

name=$(basename "$path" | tr ' .:/' '____')   # tmux-safe window name

# Idempotent: if the inspection window already exists, don't rebuild it — just
# optionally focus it. Keeps re-adds (agent + human racing on the same repo) safe.
if tmux list-windows -t "$sess" -F '#W' | grep -qxF "$name"; then
  [ "$focus" = 1 ] && tmux select-window -t "$sess:$name"
  exit 0
fi

# git tool on top (WORKBENCH_GIT_TOOL=lazygit to swap it), empty scratchpad in
# the middle (lands here), editor on the bottom ($VISUAL/$EDITOR, else nvim/vim).
git_tool=$(resolve_git_tool)
editor=$(resolve_editor)

# Build detached: three panes stacked even-vertical, cwd = the repo in all.
# (If tmux-agent-sidebar is installed with auto-create on, it'll add its own
# pane here too, same as any other window — that's fine: its full-height
# split narrows this stack uniformly rather than disturbing it.)
tmux new-window -d -t "$sess:" -n "$name" -c "$path"
# Pin the window name to the repo. Without this, automatic-rename (on by default)
# retitles the window after the focused pane's command, so it flips between the
# git tool / shell / editor as you move between panes — the window's identity is
# the repo, not whatever happens to be focused, so lock it.
tmux set-window-option -t "$sess:$name" automatic-rename off
tmux set-window-option -t "$sess:$name" @workbench_project_root "$path"
tmux split-window -v -t "$sess:$name" -c "$path"
tmux split-window -v -t "$sess:$name" -c "$path"
tmux select-layout -t "$sess:$name" even-vertical
tmux send-keys -t "$sess:$name.1" "$git_tool" Enter
tmux send-keys -t "$sess:$name.3" "$editor" Enter
tmux select-pane -t "$sess:$name.2"           # land in the scratchpad, not tig

[ "$focus" = 1 ] && tmux select-window -t "$sess:$name"
exit 0

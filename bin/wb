#!/bin/sh
set -eu

self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
dir=$(CDPATH='' cd -- "$(dirname "$self")" && pwd -P)

printf '%s\n' 'wb is deprecated; use tmux-agent-workbench (compatibility retained through 2.1)' >&2
exec "$dir/tmux-agent-workbench-cli" "$@"

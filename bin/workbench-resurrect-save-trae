#!/bin/sh
set -eu

# Persist Trae's pane-scoped session IDs from the canonical Workbench snapshot.
# Trae's SessionStart hook is the authority that supplies the ID.

wb_tmux() {
	if [ -n "${TMUX_AGENT_WORKBENCH_TMUX_SOCKET:-}" ]; then
		tmux -S "$TMUX_AGENT_WORKBENCH_TMUX_SOCKET" "$@"
	else
		tmux "$@"
	fi
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/../lib/assistant-sessions/paths.sh"
trae_home=${TRAE_HOME:-$HOME/.trae}
resurrect_dir=$(workbench_resurrect_dir)
output="$resurrect_dir/workbench-trae-sessions.json"

mkdir -p "$resurrect_dir"
umask 077
temporary=$(mktemp "$output.tmp.XXXXXX")
trap 'rm -f "$temporary" "${snapshot_file:-}"' EXIT HUP INT TERM
snapshot_file=$(mktemp "$output.snapshot.XXXXXX")

workbench_cli=$script_dir/tmux-agent-workbench-cli
if [ -x "$workbench_cli" ] && command -v jq >/dev/null 2>&1; then
	peer_dir="$trae_home/cli/session-peers"
	peers='[]'
	if [ -d "$peer_dir" ]; then
		peers=$(find "$peer_dir" -type f -name '*.json' -exec jq -c . {} \; 2>/dev/null | jq -s . 2>/dev/null || printf '%s\n' '[]')
	fi
	if "$workbench_cli" snapshot --json >"$snapshot_file" 2>/dev/null && [ -s "$snapshot_file" ] &&
		jq -ce --argjson peers "$peers" 'if type != "object" or ((.agents // []) | type) != "array" then error("invalid snapshot") else [.agents[]?
			| select(.kind == "trae" or .kind == "traex")
			| select((.target.session_name // "") != ""
				and (.target.window_index | type) == "number"
				and (.target.pane_index | type) == "number")
			| . as $agent
			| (first(($peers[]
				| select((.pid // -1) == ($agent.process.pid // -2))
				| .threadId), null)) as $peer_session_id
			| select((($agent.hook_session_id // $peer_session_id) // "") != "")
			| {session_id: (($agent.hook_session_id // $peer_session_id)),
				session_name: .target.session_name,
				window_index: .target.window_index,
				pane_index: .target.pane_index}] end' "$snapshot_file" >"$temporary"; then
		mv "$temporary" "$output"
		exit 0
	fi
fi

printf '%s\n' 'workbench resurrect: could not save Trae sessions; retaining the previous sidecar' >&2
exit 1

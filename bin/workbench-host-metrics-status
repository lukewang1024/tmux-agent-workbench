#!/bin/sh
set -eu

settings=$(tmux display-message -p 'enabled=#{@workbench-host-metrics} mode=#{@workbench-host-metrics-mode}' 2>/dev/null || true)
read -r enabled mode <<EOF
$settings
EOF
# tmux can retain a status job after its format is hidden or reconfigured.
# An old job must stop sampling as soon as the widget is disabled.
[ "$enabled" != enabled=off ] || exit 0
mode=${mode#mode=}
script_dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd -P)
case $mode in
  compact|standard|full) ;;
  *) mode=compact ;;
esac
exec "$script_dir/workbench-host-metrics" "$mode"

#!/bin/sh
# Pick any configured tmuxinator project, then start it or switch to its
# existing tmux session. This is the canonical Workbench "new" entrypoint.
set -eu
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
dir=$(CDPATH='' cd -- "$(dirname "$self")" && pwd -P)

if ! command -v tmuxinator >/dev/null 2>&1; then
  printf '%s\n' 'tmux-agent-workbench pick project: tmuxinator not found' >&2
  exit 1
fi

projects()
{
  tmuxinator list -n | sed '1d; /^[[:space:]]*$/d'
}

if [ "${1:-}" = "--list" ]; then
  projects
  exit 0
fi

[ -n "${TMUX:-}" ] || {
  printf '%s\n' 'tmux-agent-workbench pick project: not inside tmux' >&2
  exit 1
}
project=$(projects | "$dir/tmux-agent-workbench-cli" select-list --title 'Workbench Projects') || exit 0
[ -n "$project" ] || exit 0

exec tmuxinator start "$project"

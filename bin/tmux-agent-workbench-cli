#!/bin/sh
set -eu

self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
plugin_dir=$(CDPATH='' cd -- "$(dirname "$self")/.." && pwd -P)

core=${TMUX_AGENT_WORKBENCH_BIN:-}
if [ -z "$core" ] && [ -x "$plugin_dir/target/release/tmux-agent-workbench" ]; then
  core=$plugin_dir/target/release/tmux-agent-workbench
fi
if [ -z "$core" ]; then
  installed_core=${XDG_DATA_HOME:-$HOME/.local/share}/tmux-agent-workbench/bin/tmux-agent-workbench-core
  [ ! -x "$installed_core" ] || core=$installed_core
fi

usage()
{
  cat <<'EOF'
usage: tmux-agent-workbench <command> [args]

tmux workspace workflow (distinct from the distributed `workbench` CLI)

workflow: new [--prompt] add done promote inspect run projects rebuild
agents:   agent start|list|goto|next|profiles|handoff
clients:  attach, client serve|status|setup
ui:       sidebar, popup, pick repo|project|session|agent
system:   status, doctor, config, hooks, daemon
EOF
}

need_core()
{
  [ -n "$core" ] && [ -x "$core" ] || {
    echo "tmux-agent-workbench: core unavailable; run $plugin_dir/install" >&2
    exit 127
  }
}

run_and_reconcile()
{
  command_path=$1
  shift
  if "$command_path" "$@"; then result=0; else result=$?; fi
  if [ "$result" -eq 0 ] && [ -n "$core" ] && [ -x "$core" ]; then
    "$core" workspace status >/dev/null 2>&1 || true
  fi
  return "$result"
}

[ $# -gt 0 ] || { usage; exit 2; }
command_name=$1
shift
export WB_SHIM_CALL=1
case $command_name in
  new) if [ "${1:-}" = --prompt ]; then shift; exec "$plugin_dir/git/bin/wb-new-prompt" "$@"; fi
      run_and_reconcile "$plugin_dir/git/bin/wb-new" "$@" ;;
  add) run_and_reconcile "$plugin_dir/git/bin/wb-add" "$@" ;;
  done) run_and_reconcile "$plugin_dir/git/bin/wb-done" "$@" ;;
  promote) run_and_reconcile "$plugin_dir/git/bin/wb-promote" "$@" ;;
  inspect) exec "$plugin_dir/bin/wb-inspect" "$@" ;;
  run) exec "$plugin_dir/bin/wb-run" "$@" ;;
  agent)
    [ $# -gt 0 ] || { usage >&2; exit 2; }
    agent_command=$1
    shift
    case $agent_command in
      start)
        managed=0
        if [ "${1:-}" = "--managed" ]; then managed=1; shift; fi
        WORKBENCH_MANAGED=$managed exec "$plugin_dir/bin/wb-agent" "$@"
        ;;
      list) need_core; exec "$core" snapshot --json ;;
      goto) need_core; exec "$core" pick agent ;;
      next) need_core; exec "$core" attention next ;;
      profiles) exec "$plugin_dir/bin/wb-handoff" profiles "$@" ;;
      handoff) exec "$plugin_dir/bin/wb-handoff" "$@" ;;
      *) echo "tmux-agent-workbench agent: unknown command: $agent_command" >&2; exit 2 ;;
    esac
    ;;
  attach) need_core; exec "$core" client attach "$@" ;;
  client) need_core; exec "$core" client "$@" ;;
  sidebar) need_core; exec "$core" sidebar "$@" ;;
  popup)
    need_core
    client=$(tmux display-message -p '#{client_name}')
    case $client in
      ''|*[!A-Za-z0-9_./-]*) die 'Workbench client unavailable' ;;
    esac
    exec tmux display-popup -c "$client" -E -w 100% -h 100% \
      "WORKBENCH_POPUP=1 WORKBENCH_TARGET_CLIENT='$client' '$core' sidebar"
    ;;
  projects) [ "${1:-}" = rebuild ] || { usage >&2; exit 2; }; shift
    exec "$plugin_dir/git/bin/gen-tmuxinator-configs" "$@" ;;
  pick)
    case ${1:-} in
      repo) shift; exec "$plugin_dir/bin/wb-inspect-pick" "$@" ;;
      project) shift; exec "$plugin_dir/bin/wb-project-pick" "$@" ;;
    esac
    need_core; exec "$core" pick "$@" ;;
  status) need_core; exec "$core" status "$@" ;;
  doctor|config|hooks|daemon) need_core; exec "$core" "$command_name" "$@" ;;
  -h|--help|help) usage ;;
  *) need_core; exec "$core" "$command_name" "$@" ;;
esac

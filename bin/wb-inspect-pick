#!/bin/sh
# Pick a repository for a temporary tool, scoped to the current task.
# Context variables are assigned by the sourced task-context helpers.
# shellcheck disable=SC2154
set -eu
self=$0
while [ -h "$self" ]; do
  target=$(readlink "$self")
  case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
dir=$(CDPATH='' cd -- "$(dirname "$self")" && pwd -P)
. "$dir/../lib/resolve-session.sh"
. "$dir/../lib/task-context.sh"
mode=${1:---git}
case $mode in --git|--editor|--shell) : ;; *) echo 'usage: tmux-agent-workbench pick repo [--git|--editor|--shell]' >&2; exit 2 ;; esac
caller=$(workbench_resolve_pane)
scoped=$(tmux show-option -wqv -t "$caller" @workbench_task_root)
if [ -n "$scoped" ]; then
  workbench_task_context
  candidates=$(for member in "$wb_task_root" "$wb_task_root"/*; do
    [ -d "$member" ] && [ ! -L "$member" ] && [ -e "$member/.git" ] || continue
    printf '%s\n' "$member"
  done)
  [ -n "$candidates" ] || candidates=$wb_task_root
else
  candidates=$({
    zoxide query -l 2>/dev/null || true
    sed -n 's/^root:[[:space:]]*//p' "${XDG_CONFIG_HOME:-$HOME/.config}"/tmuxinator/*.yml 2>/dev/null |
      sed "s/^'//;s/'$//;s/''/'/g" || true
  } | awk 'NF && !seen[$0]++')
fi
sel=$(printf '%s\n' "$candidates" | "$dir/tmux-agent-workbench-cli" select-list --title 'Temporary tool') || exit 0
[ -n "$sel" ] || exit 0
exec "$dir/tmux-agent-workbench-cli" inspect "$sel" "$mode"
